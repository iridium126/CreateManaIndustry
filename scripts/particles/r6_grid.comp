#version 450 core
layout(local_size_x=256)in;
layout(std430,binding=0)readonly buffer Pool{vec4 data[];}pool;
layout(std430,binding=5)readonly buffer Emitters{vec4 rows[];}emitters;
layout(std430,binding=13)buffer Grid{uint words[];}g;
uniform uint uLive,uBase,uCapacity,uBuckets,uPhase,uStage;
uniform uvec2 uGeneration;
uniform float uCell;
shared uint values[256];
uint offsets(){return 16u+uBuckets;}uint cursors(){return 17u+2u*uBuckets;}uint sums(){return 17u+3u*uBuckets;}
uint entries(){return (sums()+(uBuckets+255u)/256u+63u)&~63u;}
uint hash(ivec3 c){return (uint(c.x)*92837111u^uint(c.y)*689287499u^uint(c.z)*283923481u)&(uBuckets-1u);}
void main(){uint i=gl_GlobalInvocationID.x,t=gl_LocalInvocationID.x,block=gl_WorkGroupID.x;
 if(uPhase==0u){if(i<uBuckets){g.words[uBase+16u+i]=0u;g.words[uBase+cursors()+i]=0u;}if(i==0u){g.words[uBase]=0u;g.words[uBase+1u]=uGeneration.x;g.words[uBase+2u]=uGeneration.y;g.words[uBase+3u]=uStage;g.words[uBase+5u]=uBuckets;}return;}
 if(uPhase==2u){uint at=uBase+16u+i;values[t]=i<uBuckets?g.words[at]:0u;barrier();
  for(uint step=1u;step<256u;step*=2u){uint v=t>=step?values[t-step]:0u;barrier();values[t]+=v;barrier();}
  if(i<uBuckets)g.words[uBase+offsets()+i]=values[t]-g.words[at];if(t==255u)g.words[uBase+sums()+block]=values[t];return;}
 if(uPhase==3u){if(i==0u){uint total=0u;for(uint k=0u;k<(uBuckets+255u)/256u;k++){uint n=g.words[uBase+sums()+k];g.words[uBase+sums()+k]=total;total+=n;}
  g.words[uBase+offsets()+uBuckets]=total;g.words[uBase+4u]=total;g.words[uBase]=total<=uCapacity?1u:0u;}return;}
 if(uPhase==4u){if(i<uBuckets)g.words[uBase+offsets()+i]+=g.words[uBase+sums()+block];return;}
 if(i>=uLive)return;uint emitter=floatBitsToUint(pool.data[i*4u+3u].w);if(emitters.rows[emitter*20u+18u].x<.5)return;
 vec4 p=pool.data[i*4u];ivec3 c=ivec3(floor(p.xyz/uCell));uint bucket=hash(c);
 if(uPhase==1u){atomicAdd(g.words[uBase+16u+bucket],1u);return;}
 if(uPhase==5u&&g.words[uBase]!=0u){uint rank=atomicAdd(g.words[uBase+cursors()+bucket],1u),at=uBase+entries()+(g.words[uBase+offsets()+bucket]+rank)*8u;
  g.words[at]=floatBitsToUint(p.x);g.words[at+1u]=floatBitsToUint(p.y);g.words[at+2u]=floatBitsToUint(p.z);g.words[at+3u]=(uint(p.w+.5)&262143u)-1u;
  g.words[at+4u]=uint(c.x);g.words[at+5u]=uint(c.y);g.words[at+6u]=uint(c.z);g.words[at+7u]=i;}
}

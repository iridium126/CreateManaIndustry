#pragma cmi_include packages/environment_state.glsl
layout(local_size_x=1) in;
uniform uint uBody,uThrough,uFire,uPermissions;
uniform float uHealth;
void main(){
    PackageEnvironment e=environment[uBody];
    if(e.control.z==0u||uThrough<=e.lease.w||uThrough>e.lease.z||e.lease.z-uThrough>PACKAGE_ENV_HISTORY)return;
    uint fire=uFire;float health=uHealth;bool terminal=false;
    // Rebase on the server result, then replay only the still unconfirmed suffix.
    for(uint serial=uThrough;serial<e.lease.z;serial++){
        uint offset=uBody*PACKAGE_ENV_HISTORY+serial%PACKAGE_ENV_HISTORY;
        PackageEnvironmentSample record=environmentSamples[offset];uint flags=uint(record.contact.w);
        if(fire>0u){if((uPermissions&4u)!=0u&&fire%20u==0u)health-=.15;fire--;}
        if((flags&uPermissions&6u)!=0u){if(fire==0u)fire=100u;else health-=.15;if(flags==2u)fire=max(fire,300u);}
        health=max(health,0.0);terminal=terminal||(flags&uPermissions&1u)!=0u||health<=.5;
        record.timeline.z=fire;record.timeline.w=floatBitsToUint(health);environmentSamples[offset]=record;
    }
    e.lease.w=uThrough;e.control.x=fire;e.control.y=terminal?1u:0u;e.control.w=uPermissions;e.state.x=health;
    environment[uBody]=e;
}


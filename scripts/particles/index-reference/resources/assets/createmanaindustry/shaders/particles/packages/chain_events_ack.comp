#pragma cmi_include packages/chain_tracks.glsl
struct Meta { uvec4 identity; uvec4 selection; };
layout(std430,binding=0) readonly buffer Metadata { Meta meta[]; };
layout(std430,binding=1) buffer Events { ChainEvent events[]; };
layout(std430,binding=2) buffer Flights { uint flight[]; };
layout(std430,binding=3) readonly buffer Records { ChainEvent records[]; };
layout(std430,binding=4) readonly buffer Header { uint requested,accepted,overflow,reserved; };
layout(local_size_x=64) in;
uniform uint uCount,uRecords,uStamp,uCancel,uUseHeader,uRecordOffset;
void main() {
    uint r=gl_GlobalInvocationID.x;if(r>=uRecords || uUseHeader!=0u && r>=accepted)return;
    ChainEvent record=records[r+uRecordOffset];uint i=record.envelope.x;
    if(i>=uCount || any(notEqual(meta[i].identity,record.identity)) || flight[i]!=uStamp)return;
    flight[i]=0u;
    // An anticipation flight can be superseded by an actual crossing. Its ACK cannot erase it.
    if(uCancel==0u && all(equal(events[i].envelope,record.envelope)))events[i].masks=uvec4(0);
}

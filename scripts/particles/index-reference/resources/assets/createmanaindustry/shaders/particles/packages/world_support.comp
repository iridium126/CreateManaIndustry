#pragma cmi_include packages/state.glsl
#pragma cmi_include packages/support.glsl
layout(local_size_x=64) in;
shared uint edgeCount[64];
void main() {
    uint i=gl_GlobalInvocationID.x,lane=gl_LocalInvocationID.x;
    uint parent=END;float separation=0,minimumY=0,velocityY=0;
    if(i<uCount) {
        Body b=src[i];minimumY=b.positionMass.y;velocityY=b.positionMass.w==0?0:b.velocityGround.y;
        if(b.positionMass.w>0 && b.previousSleep.w>=0) {
            ivec3 cell=cellOf(b.positionMass.xyz);float best=-1e30;
            uint visits=0u;bool exhausted=false;
            float reach=min(uCellSize,max(0.0,b.previousSleep.y-b.positionMass.y))+1e-4;
            for(int z=-1;z<=1&&!exhausted;z++)for(int y=-1;y<=1&&!exhausted;y++)for(int x=-1;x<=1&&!exhausted;x++) {
                ivec3 neighbor=cell+ivec3(x,y,z);uint cursor,end;cellCursor(neighbor,cursor,end);
                while(cursor!=end) {
                    if(++visits>uCandidateBudget){exhausted=true;break;}
                    uint j=cursorBody(cursor);
                    Body other=src[j];
                    if(j!=i && other.previousSleep.w>=0 && all(equal(cellOf(other.positionMass.xyz),neighbor))) {
                        vec3 delta=b.positionMass.xyz-other.positionMass.xyz;
                        vec3 overlap=b.extentYaw.xyz+other.extentYaw.xyz-abs(delta);
                        // Strict (Y,index) ordering is acyclic, including coincident centres.
                        if((delta.y>0 || (delta.y==0 && j<i)) && overlap.x>1e-4 && overlap.z>1e-4
                                && overlap.y>=-reach && overlap.y<=min(overlap.x,overlap.z)+1e-4) {
                            float gap=b.extentYaw.y+other.extentYaw.y,target=other.positionMass.y+gap;
                            if(target>best || (target==best && j<parent)){best=target;parent=j;separation=gap;}
                        }
                    }
                    cursor=cursorNext(cursor,j);
                }
            }
            if(exhausted)parent=GRID_OVERFLOW;
        }
        supportOut[i]=uvec4(parent,floatBitsToUint(separation),floatBitsToUint(minimumY),floatBitsToUint(velocityY));
    }
    edgeCount[lane]=parent==END?0u:1u;barrier();
    for(uint stride=32u;stride>0u;stride>>=1u){if(lane<stride)edgeCount[lane]+=edgeCount[lane+stride];barrier();}
    if(lane==0u && edgeCount[0]>0u)atomicAdd(supportStats.x,edgeCount[0]);
}

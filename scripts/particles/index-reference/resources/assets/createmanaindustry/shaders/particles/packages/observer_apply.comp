#pragma cmi_include packages/observer_state.glsl
layout(local_size_x=64) in;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uPatches || invalid!=0u)return;
    ObserverPatch p=observerReadPatch(i);uint local=p.selection.x,mask=p.selection.z;
    ObserverState s=state[local];
    if(mask==OBSERVER_RELEASE) { s.lifecycle.xy=p.sequence.xy;s.lifecycle.z=2u;state[local]=s;return; }
    if(mask==OBSERVER_BASELINE) {
        s.identity=p.identity;s.fence=p.fence;s.lifecycle=uvec4(p.sequence.xy,1u,p.selection.y);
        s.positionFlags=p.positionFlags;s.velocityYaw=p.velocityYaw;s.originTime=p.originTime;
        s.extentTime=vec4(p.extent.xyz,p.originTime.w);
        s.anchor=vec4(p.originTime.xyz+vec3(p.positionFlags.xyz)*(1.0/4096.0),observerYaw(s));
        s.correction=vec4(s.anchor.xyz,p.originTime.w-uSmoothing);state[local]=s;return;
    }
    vec3 displayed=observerDisplayed(s,p.originTime.w);
    float displayedYaw=observerDisplayedYaw(s,p.originTime.w);
    if((mask&1u)!=0u)s.positionFlags.xyz=p.positionFlags.xyz;
    if((mask&2u)!=0u)s.velocityYaw.xyz=p.velocityYaw.xyz;
    if((mask&4u)!=0u)s.velocityYaw.w=p.velocityYaw.w;
    if((mask&8u)!=0u)s.positionFlags.w=p.positionFlags.w;
    // A server-committed delta confirms the unchanged fields as well. Reset prediction from
    // that exact merged pose, including velocity-only stops, instead of retaining an extrapolated
    // offset forever. Field-mask merge never rewrites the exact quantized position on a stop.
    s.originTime.w=p.originTime.w;s.extentTime.w=p.originTime.w;
    s.anchor=vec4(s.originTime.xyz+vec3(s.positionFlags.xyz)*(1.0/4096.0),displayedYaw);
    s.correction=vec4(displayed,p.originTime.w);
    s.lifecycle.xy=p.sequence.xy;state[local]=s;
}

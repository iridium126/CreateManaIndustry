#pragma cmi_include packages/observer_state.glsl
struct Body { vec4 positionMass; vec4 velocityGround; vec4 extentYaw; vec4 previousSleep; };
layout(std430,binding=4) writeonly buffer ObserverBodies { Body bodies[]; };
layout(std430,binding=5) writeonly buffer ObserverHistory { vec4 history[]; };
layout(local_size_x=64) in;
shared uint groupActive,groupStale;
void main() {
    uint i=gl_GlobalInvocationID.x;bool valid=i<uSlots;
    if(gl_LocalInvocationIndex==0u){groupActive=0u;groupStale=0u;}
    barrier();
    Body b;
    b.positionMass=vec4(0);b.velocityGround=vec4(0);b.extentYaw=vec4(0);b.previousSleep=vec4(0,0,0,-3);
    if(valid) {
      ObserverState s=state[i];
      if(s.lifecycle.z==1u) {
        vec3 v=observerVelocity(s);bool expired=dot(v,v)>1e-8 && uNow-s.originTime.w>uPrediction;
        vec3 feet=observerDisplayed(s,uNow),centre=feet+vec3(0,s.extentTime.y,0);
        float yaw=observerDisplayedYaw(s,uNow);
        b.positionMass=vec4(centre,1);b.velocityGround=vec4(v,(s.positionFlags.w&1)!=0?1.0:0.0);
        b.extentYaw=vec4(s.extentTime.xyz,yaw);b.previousSleep=vec4(centre,expired?-1.0:0.0);
        if(expired)atomicAdd(groupStale,1u);else atomicAdd(groupActive,1u);
      }
      bodies[i]=b;
      // Prediction and correction already ran once per instance. Identical endpoints avoid
      // applying the authority clock's partial tick a second time in ordinary/Iris vertices.
      history[2u*i]=vec4(b.positionMass.xyz,b.extentYaw.w);
      history[2u*i+1u]=vec4(b.positionMass.xyz,0);
    }
    barrier();
    if(gl_LocalInvocationIndex==0u){if(groupStale!=0u)atomicAdd(staleCount,groupStale);if(groupActive!=0u)atomicAdd(activeCount,groupActive);}
}

#pragma cmi_include packages/state.glsl
#pragma cmi_include packages/world_collision.glsl
#pragma cmi_include packages/moving.glsl
#pragma cmi_include packages/moving_support.glsl
layout(local_size_x=64) in;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;Body b=src[i];vec4 support=movingSupport[i];
    support.w=uintBitsToFloat(floatBitsToUint(support.w)&~MOVING_FRICTION_DONE);movingSupport[i]=support;
    if(uMovingReady&&movingGeometryReady()&&b.positionMass.w>0.&&b.previousSleep.w>=0.&&(floatBitsToUint(support.w)&MOVING_ID_MASK)==movingIdentity()) {
        vec3 foot=b.positionMass.xyz-vec3(0,b.extentYaw.y,0);
        vec3 shift=projectPoint(localPoint(foot,true),false)-foot;
        float closest=1.;vec3 normal=vec3(0);
        if(!sweepWorld(b,b.positionMass.xyz,shift,closest,normal))freezeForMissingCollision(b,src[i].positionMass.xyz);
        else if(closest<.99999){freezeForMissingCollision(b,b.previousSleep.xyz);}
        else {b.positionMass.xyz+=shift;b.velocityGround.xyz-=support.xyz;
            movingSupport[i]=vec4(shift*20.,uintBitsToFloat(movingIdentity()|MOVING_CARRIED));}
    }
    dst[i]=b;
}

#pragma cmi_include packages/draw_state.glsl
layout(local_size_x=64) in;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
    uvec4 result=admitted[2u*i+1u];uint s=result.x;
    if(s==0u || s>uCapacity || (result.y&4u)!=0u)return;--s;
    if(!visible(s,i,result.y))return;
    uint box=mesh(s,false),rig=mesh(s,true);
    if(box<uMeshCount)atomicAdd(commands[drawGroup(box,result.y)].y,1u);
    if(rig<uMeshCount && (result.y&1u)!=0u)atomicAdd(commands[drawGroup(rig,result.y)].y,1u);
}

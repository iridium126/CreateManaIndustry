#pragma cmi_include packages/support.glsl
layout(local_size_x=64) in;
uniform uint uCount;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
    uvec4 a=supportIn[i];
    if(a.x!=0xffffffffu) {
        if(a.x>=uCount){a.x=0xffffffffu;a.z=0x7fc00000u;}
        else {
            uvec4 p=supportIn[a.x];float gap=uintBitsToFloat(a.y),height=uintBitsToFloat(p.z)+gap;
            if(height>uintBitsToFloat(a.z)){a.z=floatBitsToUint(height);a.w=p.w;}
            a.y=floatBitsToUint(gap+uintBitsToFloat(p.y));a.x=p.x;
        }
    }
    supportOut[i]=a;
}

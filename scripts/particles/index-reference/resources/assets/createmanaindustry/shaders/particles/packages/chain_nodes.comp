#pragma cmi_include packages/chain_tracks.glsl
struct Meta { uvec4 identity; uvec4 selection; };
struct Chain { vec4 startRadius; vec4 endLength; vec4 progress; vec4 targetYaw; };
struct Body { vec4 positionMass; vec4 velocityGround; vec4 extentYaw; vec4 previousSleep; };
layout(std430,binding=0) readonly buffer Metadata { Meta meta[]; };
layout(std430,binding=1) buffer Events { ChainEvent events[]; };
layout(std430,binding=2) readonly buffer Chains { Chain chains[]; };
layout(std430,binding=3) readonly buffer Bodies { Body bodies[]; };
layout(std430,binding=4) readonly buffer Tracks { ChainTrack tracks[]; };
layout(std430,binding=5) readonly buffer Nodes { uvec4 nodes[]; };
layout(local_size_x=64) in;
uniform uint uCount,uTrackCount,uNodeCount,uStep;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
    Meta m=meta[i];if((m.selection.z&1u)==0u)return;
    Body b=bodies[i];if(b.previousSleep.w==-2.0 || b.previousSleep.w==-3.0)return;
    Chain c=chains[i];ChainEvent pending=events[i];
    uint index=m.selection.x;bool valid=index<uTrackCount && float(index)==c.startRadius.w;
    ChainTrack t;if(valid)t=tracks[index];
    if(!valid || b.previousSleep.w<0.0 || t.nodes.y>32u || t.nodes.x>uNodeCount || t.nodes.y>uNodeCount-t.nodes.x) {
        events[i]=ChainEvent(m.identity,uvec4(i,valid?t.nodes.zw:uvec2(0),uStep),uvec4(0,0,index,0x80000000u),vec4(0));return;
    }
    bool loop=t.motion.y>0.5,reversed=t.motion.z>0.5;
    float before=c.startRadius.x,after=c.progress.x;
    float anticipation=loop?mod(after+t.motion.x*.2,360.0):min(t.endLength.w,after+t.motion.x*.2);
    uint crossed=0u,ahead=0u;
    if(t.motion.x!=0.0 && pending.masks.x==0u)for(uint node=0u;node<t.nodes.y;node++) {
        uint bit=1u<<node;if((m.selection.y&bit)==0u)continue;
        uvec4 n=nodes[t.nodes.x+node];float threshold=uintBitsToFloat(n.x);
        bool actual=loop?chainLoopCrossed(before,after,threshold,reversed):before<=threshold && after>=threshold;
        bool anticipated=loop?chainLoopCrossed(before,anticipation,threshold,reversed):before<=threshold && anticipation>=threshold;
        if(actual)crossed|=bit;
        else if(anticipated && (n.y&1u)!=0u)ahead|=bit;
    }
    crossed|=pending.masks.x;ahead|=pending.masks.y;
    if(crossed!=pending.masks.x || ahead!=pending.masks.y) {
        events[i]=ChainEvent(m.identity,uvec4(i,t.nodes.zw,uStep),uvec4(crossed,ahead,index,(loop?1u:0u)|(reversed?2u:0u)),
                vec4(before,after,t.motion.x,0));
    }
}

        bool position=op==NATIVE_TELEPORT || (op==NATIVE_MOVE && (flags&2u)!=0u);
        if(op==NATIVE_TELEPORT)n.base.xyz=nativeAbsolute(p);
        else if(position)n.base.xyz=nativeMoved(n.base.xyz,ivec3(p.a.xyz));
        if(op==NATIVE_MOTION)n.velocity.xyz=(n.velocity.xyz+dvec3(ivec3(p.a.xyz))/8000.0)*.5;
        if(op==NATIVE_TELEPORT || (op==NATIVE_MOVE && (flags&4u)!=0u))s.velocityYaw.w=floatBitsToInt(nativeYaw(flags));
        if(op==NATIVE_MOVE || op==NATIVE_TELEPORT)s.positionFlags.w=int(flags&1u);
        s.velocityYaw.xyz=floatBitsToInt(vec3(n.velocity.xyz*20.0));

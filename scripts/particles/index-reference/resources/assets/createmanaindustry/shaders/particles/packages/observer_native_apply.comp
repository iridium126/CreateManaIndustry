#pragma cmi_include packages/observer_native_state.glsl
layout(local_size_x=64) in;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uPatches || invalid!=0u)return;
    NativePatch p=nativeReadPatch(i);uint local=p.selection.x,op=p.selection.z,flags=p.selection.w;float receipt=p.attributes.w;
    ObserverState s=state[local];NativeObserverState n=nativeState[local];
    if(op==OBSERVER_RELEASE){s.lifecycle.xy=p.sequence.xy;s.lifecycle.z=2u;state[local]=s;return;}
    if(op==OBSERVER_BASELINE) {
        n.base=dvec4(nativeAbsolute(p),0);n.velocity=dvec4(nativeBaselineVelocity(p),0);
        s.identity=p.identity;s.fence=p.fence;s.lifecycle=uvec4(p.sequence.xy,1u,p.selection.y);
        s.positionFlags=ivec4(0,0,0,int(flags&1u));

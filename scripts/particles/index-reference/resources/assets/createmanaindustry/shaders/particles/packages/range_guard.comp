#define CMI_EXACT_RANGES
#pragma cmi_include packages/state.glsl
layout(local_size_x=64) in;
layout(std430,binding=6) readonly buffer BodySlots { uint bodySlots[]; };
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
    Body b=src[i];
    if(b.positionMass.w>0.0 && b.previousSleep.w>=0.0) {
        uint slot=bodySlots[i];
        if(slot==GRID_OVERFLOW || heads[slot*4u+3u]==GRID_OVERFLOW)freezeForMissingCollision(b,b.previousSleep.xyz);
    }
    // Publish all admission decisions before consumers run. Positions stay
    // unchanged, so the exact-cell index still names this new state correctly.
    dst[i]=b;
}

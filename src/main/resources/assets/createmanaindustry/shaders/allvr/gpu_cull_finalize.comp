// ALLVR GPU-cull finalize (doc §9.1/§9.4): one thread converts the two
// temporal-segment counts into the indirect dispatch sizes. cmdgen and
// revalidate both run at local_size_x=64, so each entry over-dispatches by at
// most 63 invocations (plus one empty group for a zero-count frame);
// max(count,1) keeps a zero-count frame valid. p1 is final here — traversal
// already appended, cmdgen/revalidate never do.
layout(local_size_x = 1) in;

layout(std430, binding = BIND_QUEUE) readonly buffer Queue {
    uint queue[]; // [0] p1 count, [1] p2 count
};
layout(std430, binding = BIND_DISPATCH) writeonly buffer Dispatch {
    uvec4 dispatch[2]; // [0] cmdgen groups, [1] revalidate groups (4c-2)
};

void main() {
    uint p1 = min(queue[0], uint(QUEUE_CAPACITY));
    uint p2 = min(queue[1], uint(QUEUE_CAPACITY));
    dispatch[0] = uvec4(max((p1 + p2 + 63u) / 64u, 1u), 1u, 1u, 0u);
    // revalidate consumes the p1 segment after the draw — its group count is
    // likewise GPU-derived, replacing the old constant QUEUE_CAPACITY/64
    // dispatch (4c-2 indirect dispatch)
    dispatch[1] = uvec4(max((p1 + 63u) / 64u, 1u), 1u, 1u, 0u);
}

// ALLVR phase-1 revalidation (doc §9.2 two-phase tail): after this frame's
// terrain draw, the fresh HiZ pyramid is built; this kernel re-tests the
// nodes that rendered unconditionally as phase-1. A node the fresh pyramid
// occludes loses its stamp — it drops to the phase-2 (tested) segment next
// frame, so steady-state occlusion still culls island backs despite the
// phase-1 bypass.
//
// Membership comes from the p1 queue segment, NOT the stamp: traversal
// re-stamps EVERY visible node — phase-1 included — with uFrameId, so the
// original stamp-based test (b.y == uLastFrameId) matched an always-empty
// set and revalidation silently never ran (review 2026-09-04). The queue
// entry was appended exactly when the node bypassed the HiZ test, which IS
// the membership record.
//
// p1 is a GPU-side counter (the hot path stays zero-readback), so the
// dispatch size is GPU-derived too: finalize wrote ceil(p1/64) into
// dispatch[1] and the Java side issues glDispatchComputeIndirect(16) (4c-2).
// Over-dispatch is ≤63 idle invocations; invocations past the p1 count exit
// on the queue bounds.
#pragma cmi_include chunks/node_common.glsl
#pragma cmi_include chunks/hiz_test.glsl

layout(local_size_x = 64) in;

layout(std430, binding = BIND_QUEUE) readonly buffer Queue {
    uint queue[]; // [0] p1 count, [1] p2 count, [2..] p1 entries, [2+CAP..] p2
};
layout(std430, binding = BIND_CUBEINFO) readonly buffer RevalidateCubeInfoBuf {
    ivec4 revalidateCubeInfo[]; // same draw record used by traversal + terrain.vsh
};

uniform ivec3 uCamInt;

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint p1 = min(queue[0], uint(QUEUE_CAPACITY));
    if (id >= p1) {
        return; // over-dispatch guard (indirect dispatch sized ceil(p1/64) by finalize)
    }
    uint nodeIdx = queue[2u + id];
    Node n = nodes[nodeIdx];
    if (!nodeLive(n)) {
        return; // freed since traversal — nothing to re-test
    }
    uint drawSlot = n.b.w & NODE_SLOT_MASK;
    if (drawSlot == 0u || drawSlot >= uint(revalidateCubeInfo.length())) {
        nodes[nodeIdx].b.y = 0u;
        return;
    }
    ivec4 drawInfo = revalidateCubeInfo[drawSlot];
    int drawLevel = clamp(drawInfo.w, 0, 3);
    // The near scene is indexed by 16³ render cells.  Legacy LOD scale is no
    // longer part of the runtime node protocol.
    ivec3 extent = ivec3(16);
    ivec3 relOrigin = drawInfo.xyz - uCamInt;
    if (allvrHizOccluded(relOrigin, extent)) {
        nodes[nodeIdx].b.y = 0u; // drops out of phase-1 next frame
    }
}

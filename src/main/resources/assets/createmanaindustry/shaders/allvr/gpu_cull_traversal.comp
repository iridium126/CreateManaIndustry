// ALLVR GPU-cull traversal, 4b slice (doc §9.1/§9.2): frustum cull + HiZ
// occlusion test against LAST frame's pyramid + two-phase temporal split.
// One invocation per node (CPU dispatches ceil(highWater/64) groups of 64).
//
// Two-phase occlusion: nodes visible last frame (b.y == uLastFrameId) skip
// the HiZ test and append to the phase-1 (front) queue segment — they render
// unconditionally so their depth is on screen while the frame rasterizes;
// everything else is HiZ-tested and appends to the phase-2 (back) segment.
// cmdgen emits phase-1 commands first, so within the single MDI draw the
// known-visible depth lands before the new geometry. The phase-1 stamps are
// re-checked after this frame's draw (gpu_cull_revalidate) against the fresh
// pyramid, so steady-state occlusion still culls island backs.
//
// Visibility uses the exact same draw record and Proj*View transform as
// terrain.vsh.  This is deliberately a homogeneous 8-corner reject instead
// of CPU-extracted planes: it stays conservative for boxes crossing the eye
// plane and cannot cull a node at node-buffer position A only to draw the
// recycled cubeInfo slot at position B (the view-dependent LOD artifact).
#pragma cmi_include chunks/node_common.glsl
#pragma cmi_include chunks/hiz_test.glsl

layout(local_size_x = 64) in;

uniform mat4 uViewProjection;
uniform ivec3 uCamInt;
// Also declared by hiz_test.glsl; always uploaded even when HiZ is disabled.
// uniform vec3 uCamFrac;
uniform uint uFrameId;
uniform uint uLastFrameId;
uniform uint uHizEnabled;

layout(std430, binding = BIND_QUEUE) buffer Queue {
    uint queue[]; // [0] p1 count, [1] p2 count, [2..] p1 entries, [2+CAP..] p2 entries
};

layout(std430, binding = BIND_CUBEINFO) readonly buffer CullCubeInfoBuf {
    ivec4 cullCubeInfo[]; // identical record consumed by terrain.vsh
};

bool allvrOutsideFrustum(ivec3 relOrigin, ivec3 extent) {
    // A convex box is outside only when all eight corners violate the same
    // homogeneous clip plane.  Boxes intersecting the eye/near plane pass,
    // which is the required conservative behavior.
    uint rejectMask = 0x3Fu; // -x,+x,-y,+y,-z,+z
    for (uint corner = 0u; corner < 8u; corner++) {
        ivec3 offset = ivec3(
            (corner & 1u) != 0u ? extent.x : 0,
            (corner & 2u) != 0u ? extent.y : 0,
            (corner & 4u) != 0u ? extent.z : 0);
        vec3 rel = vec3(relOrigin + offset) - uCamFrac;
        vec4 clip = uViewProjection * vec4(rel, 1.0);
        if (clip.x >= -clip.w) rejectMask &= ~0x01u;
        if (clip.x <=  clip.w) rejectMask &= ~0x02u;
        if (clip.y >= -clip.w) rejectMask &= ~0x04u;
        if (clip.y <=  clip.w) rejectMask &= ~0x08u;
        if (clip.z >= -clip.w) rejectMask &= ~0x10u;
        if (clip.z <=  clip.w) rejectMask &= ~0x20u;
    }
    return rejectMask != 0u;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= nodes.length()) {
        return; // over-dispatch / dead-tail guard
    }
    Node n = nodes[idx];
    if (!nodeLive(n)) {
        return;
    }
    uint drawSlot = n.b.w & NODE_SLOT_MASK;
    if (drawSlot == 0u || drawSlot >= uint(cullCubeInfo.length())) {
        return; // corrupt/stale node: never perform an out-of-bounds read
    }
    ivec4 drawInfo = cullCubeInfo[drawSlot];
    int drawLevel = clamp(drawInfo.w, 0, 3);
    // ALLVR near nodes are 16³ render cells.  Legacy LOD levels are gone;
    // keep the table's fourth word ignored for ABI compatibility.
    ivec3 extent = ivec3(16);
    ivec3 relOrigin = drawInfo.xyz - uCamInt;

    if (allvrOutsideFrustum(relOrigin, extent)) {
        return;
    }

    // two-phase temporal: last-frame-visible bypasses the HiZ test
    bool lastVisible = n.b.y == uLastFrameId;
    if (uHizEnabled != 0u && !lastVisible && allvrHizOccluded(relOrigin, extent)) {
        return;
    }

    // visible: stamp + append to the node's phase segment
    nodes[idx].b.y = uFrameId;
    uint phase = lastVisible ? 0u : 1u;
    uint slot = atomicAdd(queue[phase], 1u);
    if (slot < QUEUE_CAPACITY) {
        queue[2u + phase * uint(QUEUE_CAPACITY) + slot] = idx;
    }
}

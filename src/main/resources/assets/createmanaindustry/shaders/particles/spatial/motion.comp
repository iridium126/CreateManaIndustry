layout(local_size_x=256) in;
struct Row {vec4 position,velocity;uvec4 identity;vec4 preferred;};
layout(std430,binding=0) buffer Packet {uint header[32];Row rows[];} packet;
layout(std430,binding=1) buffer Pool {vec4 rows[];} pool;
layout(std430,binding=3) readonly buffer Count {uint live;} count;
layout(std430,binding=5) readonly buffer Terrain {Row rows[];} terrain;
#ifndef CMI_MOTION_PUBLICATION_ONLY
layout(std430,binding=6) readonly buffer LocalRead {Row rows[];} localRead;
layout(std430,binding=7) buffer LocalWrite {Row rows[];} localWrite;
layout(std430,binding=9) buffer Grid {int heads[262144];int next[];} grid;
#endif
layout(std430,binding=28) readonly buffer State {uint words[];} state;
#pragma cmi_include chunks/population_read.glsl
#ifndef CMI_MOTION_PUBLICATION_ONLY
#pragma cmi_include chunks/storm_collision.glsl
#endif
layout(rgba32ui,binding=4) uniform uimageBuffer motionWrite;
layout(rgba32ui,binding=5) uniform uimageBuffer motionMeta;
layout(rgba32ui,binding=7) readonly uniform uimageBuffer motionRead;
uniform uint phase,capacity,terrainCapacity,terrainCount,probes,kind,visitsLimit,nearestLimit,memberRange;
uniform uvec2 nonce,epoch,sourceTick,scene;
uniform float timeSec;
uniform bool stateEnabled;
uint hashCell(ivec3 c){return (uint(c.x)*92837111u^uint(c.y)*689287499u^uint(c.z)*283923481u)&262143u;}
Row loadMotion(uint i,bool prior){int at=int(i*4u);return prior?Row(uintBitsToFloat(imageLoad(motionRead,at)),uintBitsToFloat(imageLoad(motionRead,at+1)),imageLoad(motionRead,at+2),uintBitsToFloat(imageLoad(motionRead,at+3))):Row(uintBitsToFloat(imageLoad(motionWrite,at)),uintBitsToFloat(imageLoad(motionWrite,at+1)),imageLoad(motionWrite,at+2),uintBitsToFloat(imageLoad(motionWrite,at+3)));}
void storeMotion(uint i,Row row){int at=int(i*4u);imageStore(motionWrite,at,floatBitsToUint(row.position));imageStore(motionWrite,at+1,floatBitsToUint(row.velocity));imageStore(motionWrite,at+2,row.identity);imageStore(motionWrite,at+3,floatBitsToUint(row.preferred));}
#ifndef CMI_MOTION_PUBLICATION_ONLY
bool clearSweep(vec3 a,vec3 b){
 if(!uStormCollisionEnabled||!uStormCollisionOn)return false;if(cmiStormAirSweep(a,b))return true;
 ivec3 lo=ivec3(floor(min(a,b)+vec3(-.17499,.00001,-.17499))),hi=ivec3(floor(max(a,b)+vec3(.17499,.59999,.17499)));
 for(int x=lo.x;x<=hi.x;x++)for(int y=lo.y;y<=hi.y;y++)for(int z=lo.z;z<=hi.z;z++){ivec3 cell=ivec3(x,y,z);int page=cmiStormLookupPage(cell>>4);if(page==-1||page==-3||(page>=0&&cmiStormSolidInPage(cell,page)))return false;}return true;
}
#endif
void main(){
 uint i=gl_GlobalInvocationID.x;
 if(phase==0u){if(i<capacity){imageStore(motionWrite,int(i*4u+2u),uvec4(i,0,0,0));imageStore(motionMeta,int(i),uvec4(0));}return;}
 if(phase==1u||phase==3u){
  if(i<memberRange)packet.rows[i]=loadMotion(i,phase==1u);
  else if(i<memberRange+terrainCount)packet.rows[capacity+i-memberRange]=terrain.rows[i-memberRange];
  if(i==0u){for(uint k=0u;k<32u;k++)packet.header[k]=0u;packet.header[0]=0x41313149u;packet.header[1]=12u;packet.header[2]=nonce.x;packet.header[3]=nonce.y;packet.header[4]=epoch.x;packet.header[5]=epoch.y;packet.header[6]=sourceTick.x;packet.header[7]=sourceTick.y;uvec2 target=sourceTick+uvec2(1,0);if(target.x==0u)target.y++;packet.header[8]=target.x;packet.header[9]=target.y;packet.header[10]=capacity;packet.header[12]=floatBitsToUint(timeSec);packet.header[13]=floatBitsToUint(.05);packet.header[14]=floatBitsToUint(.1);packet.header[16]=scene.x;packet.header[17]=scene.y;packet.header[18]=1u;packet.header[19]=probes;packet.header[20]=kind;packet.header[28]=terrainCount;packet.header[29]=32u+capacity*16u;}return;
 }
 if(phase==2u){
  if(i>=cmiPopulationCount(count.live,true))return;uint slot=cmiPopulationSlot(i,count.live,true);if(slot>=count.live)return;uint base=slot*4u;vec4 p0=pool.rows[base],p1=pool.rows[base+1u],p3=pool.rows[base+3u];uint member=(uint(p0.w+.5)&MEMBER_IDX_MASK)-1u;if(member>=capacity)return;
  Row row=loadMotion(member,false);uint token=floatBitsToUint(p3.z);bool same=row.identity.y==token&&(row.identity.w&1u)!=0u;
  row.position=vec4(p0.xyz,.34);row.velocity=vec4(p1.xyz,same?row.velocity.w:32.);uint tag=stateEnabled?CMI_STATE(state,member*2u+1u)&255u:0u,attack=stateEnabled?CMI_STATE(state,member*2u):0u;
  row.identity=uvec4(member,token,floatBitsToUint(p3.w),(p3.y>0.?1u:0u)|(tag<<8u)|(same?row.identity.w&0x80000000u:0u));row.preferred=vec4(same?row.preferred.xyz:p1.xyz,uintBitsToFloat(attack));storeMotion(member,row);
  uvec4 meta=imageLoad(motionMeta,int(member));if(!same)meta.xyz=floatBitsToUint(p0.xyz);meta.w=(meta.w&0xe0000000u)|(slot+1u);imageStore(motionMeta,int(member),meta);return;
 }
#ifndef CMI_MOTION_PUBLICATION_ONLY
 if(phase==4u){if(i<262144u)grid.heads[i]=0;return;}
 if(i>=capacity)return;
 if(phase==5u){Row row=loadMotion(i,false);if((row.identity.w&1u)==0u)return;uint h=hashCell(ivec3(floor(row.position.xyz/.5)));grid.next[i]=atomicExchange(grid.heads[h],int(i)+1);return;}
 if(phase==7u){Row row=localRead.rows[i];if((row.identity.w&1u)!=0u){storeMotion(i,row);uint at=imageLoad(motionMeta,int(i)).w&0x1fffffffu;if(at>0u&&at<=count.live)pool.rows[(at-1u)*4u].xyz=row.position.xyz;}return;}
 Row row=loadMotion(i,false);if(phase==6u)localWrite.rows[i]=row;if((row.identity.w&1u)==0u||(row.identity.w&0x80000000u)!=0u)return;
 uint nearest[8];float distances[8];uint used=0u,visits=0u,status=0u;ivec3 cell=ivec3(floor(row.position.xyz/.5));
 for(int x=-1;x<=1&&visits<visitsLimit;x++)for(int y=-1;y<=1&&visits<visitsLimit;y++)for(int z=-1;z<=1&&visits<visitsLimit;z++){
  int link=grid.heads[hashCell(cell+ivec3(x,y,z))];while(link!=0&&visits<visitsLimit){uint j=uint(link-1);link=grid.next[j];visits++;if(j==i)continue;Row other=loadMotion(j,false);if(any(notEqual(ivec3(floor(other.position.xyz/.5)),cell+ivec3(x,y,z))))continue;
   vec3 delta=row.position.xyz-other.position.xyz;float d2=dot(delta,delta);if(d2>=.16)continue;uint at=min(used,nearestLimit-1u);if(used==nearestLimit&&d2>=distances[at])continue;
   while(at>0u&&d2<distances[at-1u]){distances[at]=distances[at-1u];nearest[at]=nearest[at-1u];at--;}distances[at]=d2;nearest[at]=j;used=min(nearestLimit,used+1u);
  }if(link!=0)status|=0x20000000u;
 }
 if(visits>=visitsLimit)status|=0x20000000u;
 vec3 correction=vec3(0);for(uint k=0u;k<used;k++){vec3 delta=row.position.xyz-loadMotion(nearest[k],false).position.xyz;float d=sqrt(distances[k]);if(d<.34)status|=0x40000000u;
  if(d<1e-6){uint a=min(i,nearest[k]),h=a*1664525u+1013904223u;delta=normalize(vec3(float(h&1023u)-511.,float((h>>10u)&1023u)-511.,float((h>>20u)&1023u)-511.))*(i<nearest[k]?1.:-1.);}else delta/=d;correction+=delta*(.4-d)*.5;
 }
 uvec4 meta=imageLoad(motionMeta,int(i));
 if(phase==8u){meta.w=(meta.w&~0x40000000u)|status;imageStore(motionMeta,int(i),meta);return;}
 float size=length(correction),limit=min(.03,row.velocity.w*.05);if(size>limit)correction*=limit/max(size,1e-8);vec3 target=row.position.xyz+correction,origin=uintBitsToFloat(meta.xyz);float cap=row.velocity.w*.05,travel=distance(target,origin);
 if(distance(row.position.xyz,origin)>cap+.0001){target=row.position.xyz;status|=0x80000000u;}else if(travel>cap)target=origin+(target-origin)*(cap/max(travel,1e-8));
 if(!clearSweep(row.position.xyz,target)){target=row.position.xyz;status|=0x80000000u;}localWrite.rows[i].position.xyz=target;meta.w|=status;imageStore(motionMeta,int(i),meta);
#endif
}

layout(local_size_x = 64) in;
layout(std430, binding = BIND_POOL_WRITE) readonly buffer HexPool { vec4 data[]; } pool;
layout(std430, binding = BIND_SORT_READ) readonly buffer Sorted { uvec2 kv[]; } sorted;
layout(std430, binding = BIND_INDIRECT) readonly buffer Indirect { uint cmd[INDIRECT_UINTS]; } indirect;
layout(std430, binding = 27) writeonly buffer HexCommands { uvec4 cmd[]; } draws;
layout(std430, binding = 28) buffer HexPoints { vec4 point[]; } outputPoints;
#pragma cmi_include chunks/hex_pattern.glsl
#pragma cmi_include chunks/hex_noise.glsl
void main() {
    uint group = gl_WorkGroupID.x, thread = gl_LocalInvocationID.x;
    if (thread == 0u) draws.cmd[group] = uvec4(0);
    if (group >= indirect.cmd[IDX_CNT_PATTERN]) return;
    uint index = sorted.kv[indirect.cmd[IDX_CNT_MODELOP] + indirect.cmd[IDX_CNT_ALPHA] + group].y >> 2;
    uint handle = floatBitsToUint(pool.data[index * 4u + 3u].z);
    if (!hexValid(handle)) return;
    uint slot = handle & 4095u, b = hexBase(slot);
    uint source = floatBitsToUint(hexInput.v[b].y), count = floatBitsToUint(hexInput.v[b].z);
    uint dest = floatBitsToUint(hexInput.v[b + 4u].x);
    if (thread == 0u) {
        draws.cmd[group] = uvec4(floatBitsToUint(hexInput.v[b+4u].y), 1, slot * HEX_VERTEX_STRIDE, 0);
        float k = hexInput.v[b+1u].y, life = hexInput.v[b+1u].x, time = hexInput.v[HEX_ANCHORS + floatBitsToUint(hexInput.v[b].w)].w;
        precise float rotationA = time * hexInput.v[b+4u].z;
        precise float rotation = rotationA * hexInput.v[b+4u].w;
        float angle = radians(mod(rotation,360.0)+(1.0+k)*45.0);
        float scale = min(1.0,life/5.0)/24.0;
        uint t = 4096u + slot*8u;
        hexLive.index[t] = floatBitsToUint(cos(angle));
        hexLive.index[t+1u] = floatBitsToUint(sin(angle));
        hexLive.index[t+2u] = floatBitsToUint(scale);
        hexLive.index[t+3u] = floatBitsToUint(1.0+sin(k)*0.75+(floor(k/8.0)+sin(time/(7.0+k/8.0)))*scale);
        hexLive.index[t+4u] = floatBitsToUint(0.75+cos(k/8.0)*0.25+cos(time/(7.0+floor(k/4.0)))*0.065);
    }
    double seed = double(floatBitsToInt(hexInput.v[b+1u].z));
    double zSeed = double(hexInput.v[0].w) * double(0.1f);
    for (uint i = thread; i < count; i += 64u) {
        vec4 ends = hexResource.v[source + i * 2u];
        vec4 spec = hexResource.v[source + i * 2u + 1u];
        vec2 p = mix(ends.xy, ends.zw, spec.y);
        if (spec.w > 0.0) {
            double progress = double(spec.w) / 6.0;
            double minor = hexNoise(dvec3(double(spec.x), double(spec.w), double(sin(float(mod(zSeed, 6.283185307179586lf)))))) * double(0.2f);
            float theta = float(3.0 * hexNoise(dvec3(double(spec.x) + progress + minor - zSeed,1337,seed)) * 6.283185307179586lf);
            float r = float(hexNoise(dvec3(double(spec.x) + progress - zSeed,69420,seed)) * double(spec.z)
                * min(1.0, 8.0 * (0.5 - abs(0.5 - progress))));
            p += r * vec2(cos(theta), sin(theta));
        }
        outputPoints.point[dest+i] = vec4(p,0,0);
    }
    memoryBarrierBuffer();
    barrier();
    // Each join is evaluated once; all ribbon vertices reuse its angle and half-angle tangent.
    for (uint i = thread+1u; i+1u < count; i += 64u) {
        vec2 a = outputPoints.point[dest+i].xy-outputPoints.point[dest+i-1u].xy;
        vec2 z = outputPoints.point[dest+i+1u].xy-outputPoints.point[dest+i].xy;
        float angle = dot(a,a)*dot(z,z) < 1e-12 ? 0.0 : atan(a.x*z.y-a.y*z.x,dot(a,z));
        outputPoints.point[dest+i].zw = vec2(angle,sin(angle)/max(1e-7,1.0+cos(angle)));
    }
}

// Wave-contact self-report detection (dive-wave AI, docs/allay-storm-ai.md §7).
// Dispatched every frame while a wave is live: one thread per live pool
// particle tests whether a wave-squad member in its pursuit window is touching
// THIS client's local player. The GPU holds the exact positions, so the
// contact lands on the visual moment with zero quantization delay; the result
// rides the frame fence back and the runtime ships a
// ServerboundStormWaveContactPacket (deduped per member per wave) for the
// server to validate and adjudicate. The contact point is the member's world
// position — the runtime re-frames it rel-to-center before sending, the same
// reconstruction convention the melee hit reports use (+8 reach margin).
// Cost: one distance test per member per live wave; only the handful of
// members actually touching the player reach the atomic append.
layout(local_size_x = 64) in;
#pragma cmi_include chunks/population_read.glsl

layout(std430, binding = BIND_POOL_WRITE) readonly buffer Pool { vec4 data[]; } pool;
layout(std430, binding = BIND_COUNTER) readonly buffer CounterBuf { uint writeSlot; uint spare; uint translucentCensus; } counter;
layout(std430, binding = BIND_EMITTER) readonly buffer EmitterBuf { vec4 u[]; } emitters;
// {uint count; float entries[];} — entries begin at byte 4 (std430 stride 4).
// Entry stride 5: {memberIdx, waveId, pos.xyz} (world space; Java reframes).
layout(std430, binding = BIND_WAVECONTACT) buffer WaveContactBuf { uint count; float entries[]; } result;

layout(std430, binding = BIND_WAVE_STAMP) buffer WaveStamps { uint wave[]; } stamps;

layout(std430,binding=28) buffer StarStateWrite {uint words[];} state;
layout(std430,binding=BIND_POOL_READ) readonly buffer PreviousParticles {vec4 data[];} previous;
layout(std430,binding=BIND_PREV_COUNTER) readonly buffer PreviousCount {uint live;} previousCount;
layout(std430,binding=BIND_MEMBERMAP) readonly buffer Members {float slots[];} memberMap;
uniform float uDt;
uniform uint uLocalWaveMask;
uniform bool uStormNavigationDiagnostics;
uniform vec3 uLocalPlayerPos; // local player aim point (feet + 0.5), world space
// uTimeSec / uWave / uWaveTarget are declared by chunks/allay_storm.glsl
// (included below) next to the membership function that reads them

const float CONTACT_R = 1.6;

// the membership test needs no pose math — the pose-free storm chunk suffices
#pragma cmi_include chunks/allay_storm.glsl
#pragma cmi_include chunks/dome_motion_budget.glsl
#pragma cmi_include chunks/dome_path_state.glsl

void main() {
    if(uStarfallEnabled){
      uint invocation=gl_GlobalInvocationID.x;
      if(invocation==0u&&uStormNavigationDiagnostics){uint o=atomicAdd(result.count,1u);if(o<WAVECONTACT_CAP){o*=6u;result.entries[o]=-11.;result.entries[o+1u]=0.;result.entries[o+2u]=float(state.words[CMI_DOME_PATH_CONTROL+10u]);result.entries[o+3u]=float(state.words[CMI_DOME_PATH_CONTROL+9u]);result.entries[o+4u]=float(state.words[CMI_DOME_PATH_CONTROL+24u]);result.entries[o+5u]=float(state.words[CMI_DOME_PATH_CONTROL+25u]);}o=atomicAdd(result.count,1u);if(o<WAVECONTACT_CAP){o*=6u;result.entries[o]=-12.;result.entries[o+1u]=0.;result.entries[o+2u]=uintBitsToFloat(state.words[CMI_DOME_PATH_CONTROL+11u]);result.entries[o+3u]=float(state.words[CMI_DOME_PATH_CONTROL+8u]);result.entries[o+4u]=0.;result.entries[o+5u]=0.;}}

      if(invocation<4u){uint b=cmiStarBase(invocation),c=CMI_GATHER_COUNTS+invocation*4u;if((cmiHelix(b)||cmiDome(b))&&cmiStarVec(b+20u).y<3.&&cmiStarVec(b).y<1.5&&cmiStarVec(b).x>.5){uint o=atomicAdd(result.count,1u);if(o<WAVECONTACT_CAP){o*=6u;result.entries[o]=-6.;result.entries[o+1u]=cmiStarVec(b).x;for(uint j=0u;j<4u;j++)result.entries[o+2u+j]=float(state.words[c+j]);}}}
      if(invocation<4u){uint b=cmiStarBase(invocation),id=uint(cmiStarVec(b).x+.5);if(cmiDome(b)&&id>0u&&cmiStarVec(b).y<1.5&&cmiStarVec(b+20u).y<3.){
       uint revision=0u;for(uint f=0u;f<66u;f++){uint key=invocation*66u+f,at=CMI_DOME_FLOW_STATE+key*2u;float pause=uintBitsToFloat(cmiStarWord(CMI_DOME_FLOW_SOURCE+key*2u+1u));if(isinf(pause))pause=uintBitsToFloat(state.words[at+1u]);if(state.words[at]==id&&!isinf(pause))revision++;}
       uint o=atomicAdd(result.count,1u);if(o<WAVECONTACT_CAP){o*=6u;result.entries[o]=-8.;result.entries[o+1u]=float(id);result.entries[o+2u]=float(revision);result.entries[o+3u]=0.;result.entries[o+4u]=0.;result.entries[o+5u]=0.;}
      }}
      if(invocation<4u){uint b=cmiStarBase(invocation);if(cmiHelix(b)&&cmiHelixReferenceValid(b,uTimeSec)&&cmiStarVec(b+20u).y<3.){uint o=atomicAdd(result.count,1u);if(o<WAVECONTACT_CAP){o*=6u;result.entries[o]=-10.;result.entries[o+1u]=cmiStarVec(b).x;result.entries[o+2u]=cmiStarVec(cmiHelixFrame(b,uTimeSec)).x;result.entries[o+3u]=cmiHelixReferenceSeconds(b,uTimeSec);result.entries[o+4u]=0.;result.entries[o+5u]=uTimeSec;}}}
      // Same fenced snapshot as readiness, including flows paused this frame.
      for(uint f=invocation;f<264u;f+=gl_NumWorkGroups.x*64u){uint slot=f/66u,b=cmiStarBase(slot),id=uint(cmiStarVec(b).x+.5),at=CMI_DOME_FLOW_STATE+f*2u;
       if(!cmiDome(b)||cmiStarVec(b).x<.5||cmiStarVec(b).y>=1.5||cmiStarVec(b+20u).y>=3.)continue;
       float pause=uintBitsToFloat(cmiStarWord(CMI_DOME_FLOW_SOURCE+f*2u+1u));if(isinf(pause))pause=uintBitsToFloat(state.words[at+1u]);
       if(state.words[at]!=id||isinf(pause))continue;uint o=atomicAdd(result.count,1u);if(o<WAVECONTACT_CAP){o*=6u;result.entries[o]=-7.;result.entries[o+1u]=float(id);result.entries[o+2u]=float(f%66u);result.entries[o+3u]=pause;result.entries[o+4u]=0.;result.entries[o+5u]=0.;}
      }
      // Bitmaps come from the same committed frame as the aggregate. Never merge readiness across frames.
      for(uint word=invocation;word<1536u;word+=gl_NumWorkGroups.x*64u){uint slot=word/384u,b=cmiStarBase(slot),c=CMI_GATHER_COUNTS+slot*4u,eligible=state.words[c+1u],ready=state.words[c];
        bool gathered=cmiDomeGatherReady(ready,eligible,uTimeSec,cmiStarVec(b+4u).x,cmiStarVec(b+4u).y);
        if(cmiStarVec(b).x<.5||cmiStarVec(b).y>=1.5||cmiStarVec(b+20u).y>=3.||!gathered)continue;
        for(uint k=0u;k<2u;k++){uint bits=state.words[(k==0u?CMI_GATHER_READY:CMI_GATHER_ELIGIBLE)+word];if(bits==0u)continue;uint o=atomicAdd(result.count,1u);if(o<WAVECONTACT_CAP){o*=6u;result.entries[o]=k==0u?-4.:-5.;result.entries[o+1u]=cmiStarVec(b).x;result.entries[o+2u]=float(word-slot*384u);result.entries[o+3u]=float(bits&65535u);result.entries[o+4u]=float(bits>>16u);result.entries[o+5u]=uTimeSec;}}
      }
      for(uint word=invocation;word<CMI_COMPLETION_WORDS;word+=gl_NumWorkGroups.x*64u){uint bits=state.words[CMI_COMPLETIONS+word];if(bits==0u)continue;uint slot=word<1536u?word/384u:4u+(word-1536u)/2u,b=cmiStarBase(slot),id=uint(cmiStarVec(b).x+.5);if(id==0u||cmiStarVec(b).y>2.5)continue;
        uint outIndex=atomicAdd(result.count,1u);if(outIndex<WAVECONTACT_CAP){uint o=outIndex*6u;result.entries[o]=-2.;result.entries[o+1u]=float(id);result.entries[o+2u]=float(word-cmiCompletionOffset(slot));result.entries[o+3u]=float(bits&65535u);result.entries[o+4u]=float(bits>>16u);result.entries[o+5u]=uTimeSec;}}
    }
    uint liveCount=min(counter.writeSlot,uint(pool.data.length())/VEC4_PER_PARTICLE),rank=gl_GlobalInvocationID.x;
    if(rank>=cmiPopulationCount(liveCount,true))return;
    uint idx=cmiPopulationSlot(rank,liveCount,true);if(idx>=liveCount)return;

    uint base = idx * 4u;
    vec4 p0 = pool.data[base + 0u];
    vec4 p3 = pool.data[base + 3u];
    if (p3.y <= 0.0)
        return; // corpse: never reports
    uint eid = floatBitsToUint(p3.w);
    uint hb = eid * VEC4_PER_EMITTER;
    // THE storm gate is the header storm slot (same gate as update/stormpos/
    // hit): p0.w identity (memberIdx+1) collides with a non-storm MODEL's
    // size multiplier exactly at member 0
    if (emitters.u[hb + 18u].x < 0.5)
        return; // not a storm member
    // update may latch pursuit completion in this very frame. Reporting is
    // independently deduplicated by (member, wave), including latched members.
    uint stableMember=cmiStarMember(p0.w);
    if(stableMember<131072u&&(cmiStarWord(201456u+stableMember/32u)&(1u<<(stableMember&31u)))==0u&&(state.words[stableMember*2u+1u]&255u)==7u){uint o=atomicAdd(result.count,1u);if(o<WAVECONTACT_CAP){o*=6u;result.entries[o]=-3.;result.entries[o+1u]=float(state.words[stableMember*2u]);result.entries[o+2u]=float(stableMember);result.entries[o+3u]=0.;result.entries[o+4u]=0.;result.entries[o+5u]=uTimeSec;}}
    uint assignment=cmiStarAssignment(p0.w);
    if(cmiColumnAssignment(assignment)){
        uint slot=cmiStarSlot(assignment),b=cmiStarBase(slot),rank=cmiStarRank(assignment),token=cmiStarWord(b+27u),arc=328128u+((slot-4u)*64u+rank)*96u;
        if(token!=0u&&state.words[arc+39u]==token&&state.words[arc+44u]==0u){uint outputIndex=atomicAdd(result.count,1u);if(outputIndex<WAVECONTACT_CAP){uint offset=outputIndex*6u;result.entries[offset]=-9.;result.entries[offset+1u]=cmiStarVec(b).x;result.entries[offset+2u]=float(rank);result.entries[offset+3u]=float(token&65535u);result.entries[offset+4u]=float(token>>16u);result.entries[offset+5u]=0.;}}
    }
    if(uStarfallEnabled&&cmiColumnAssignment(assignment)){
        uint slot=cmiStarSlot(assignment),b=cmiStarBase(slot),member=cmiStarMember(p0.w),id=uint(cmiStarVec(b).x+.5);
        if((uLocalWaveMask&16u)==0u||cmiStarClaim(p0.w,uTimeSec)<0||member>=131072u)return;
        if(state.words[member*2u]!=id||(state.words[member*2u+1u]&255u)!=4u)return;
        float marker=pool.data[base+1u].w;if(marker> -1.||marker<= -2.)return;
        uint record=262592u+(slot-4u)*1024u;
        if(distance(p0.xyz,uLocalPlayerPos)<32.&&atomicCompSwap(state.words[record+11u],0u,id)==0u){
            uint soundSlot=atomicAdd(result.count,1u);if(soundSlot<WAVECONTACT_CAP){
                uint so=soundSlot*6u;result.entries[so]=-1.;result.entries[so+1u]=float(id);result.entries[so+2u]=p0.x;result.entries[so+3u]=p0.y;result.entries[so+4u]=p0.z;result.entries[so+5u]=uTimeSec;
            }
        }
        vec3 landing=cmiStarLanding(b,0u).xyz;float radius=length(p0.xz-landing.xz);
        if(radius>4.0001||distance(p0.xyz,uLocalPlayerPos)>CONTACT_R)return;
        uint stamp=member*4u;if(stamp>=uint(stamps.wave.length())||stamps.wave[stamp]==id)return;
        uint contactSlot=atomicAdd(result.count,1u);if(contactSlot>=WAVECONTACT_CAP)return;
        stamps.wave[stamp]=id;uint o=contactSlot*6u;
        result.entries[o]=float(member);result.entries[o+1u]=float(id);result.entries[o+2u]=p0.x;result.entries[o+3u]=p0.y;result.entries[o+4u]=p0.z;result.entries[o+5u]=uTimeSec;return;
    }
    for (uint k = 0u; k < 4u; k++) {
        if(uStarfallEnabled&&uLocalWaveMask!=0u&&(uLocalWaveMask&(1u<<k))==0u)continue;
        vec4 wt = uWaveTarget[k];
        if (wt.w < 0.5)
            continue; // slot inactive
        vec4 w = uWave[k];
        if (!uStarfallEnabled && (uTimeSec < w.z || uTimeSec > w.w))
            continue; // outside the wave window
        if (uStarfallEnabled ? cmiStarClaim(p0.w,uTimeSec)!=int(k) || cmiStarPhase(cmiStarAssignment(p0.w),uTimeSec)!=4. : !cmiStormWaveMember(p3.z, w.x, w.y))
            continue;
        uint member = (uint(p0.w + 0.5) & MEMBER_IDX_MASK) - 1u;
        vec3 contact=p0.xyz;float hitTime=uTimeSec;
        if(uStarfallEnabled&&(cmiHelix(cmiStarBase(k))||cmiDome(cmiStarBase(k)))){
            if(pool.data[base+1u].w!= -4.)continue;
            uint b=cmiStarBase(k);if(member>=uint(memberMap.slots.length())||(state.words[member*2u+1u]&0x80000000u)!=0u)continue;
            uint old= floatBitsToUint(memberMap.slots[member]);if(old==0u||old>previousCount.live||old>uint(previous.data.length())/4u)continue;
            vec4 before=previous.data[(old-1u)*4u],beforeLife=previous.data[(old-1u)*4u+3u];
            if(cmiStarMember(before.w)!=member||beforeLife.y<=0.||floatBitsToUint(beforeLife.w)!=eid)continue;
            vec3 segment=p0.xyz-before.xyz;uint ownerAssignment=cmiStarAssignment(p0.w);float distance2=dot(segment,segment),limit=(cmiDome(b)?CMI_DOME_MOTION_LIMIT(state,ownerAssignment,4u):cmiAttackSpeed(p0.w,uTimeSec,6.))*uDt+.01;
            if(distance2>limit*limit)continue;
            float alpha=distance2>1e-8?clamp(dot(uLocalPlayerPos-before.xyz,segment)/distance2,0.,1.):1.;
            contact=before.xyz+alpha*segment;hitTime=uTimeSec-uDt*(1.-alpha);
            if(cmiStarPhase(cmiStarAssignment(p0.w),hitTime)!=4.)continue;
        }
        vec3 d = contact - uLocalPlayerPos;
        if (dot(d, d) > CONTACT_R * CONTACT_R)
            continue;
        if(uStarfallEnabled&&(member>=131072u||state.words[member*2u]!=uint(wt.w)||(state.words[member*2u+1u]&255u)!=4u||(cmiStarVec(cmiStarBase(k)+20u).x<.5&&state.words[262400u+k*32u+((cmiStarAssignment(p0.w)>>3u)&31u)]!=128u)))continue;
        uint stampIndex = member * 4u + k;
        if (stampIndex >= uint(stamps.wave.length()) || stamps.wave[stampIndex] == uint(wt.w)) continue;
        uint slot = atomicAdd(result.count, 1u);
        if (slot >= WAVECONTACT_CAP)
            return;
        stamps.wave[stampIndex] = uint(wt.w);
        uint stride=uStarfallEnabled?6u:5u;
        uint o = slot * stride;
        result.entries[o + 0u] = float(uint(p0.w + 0.5) & MEMBER_IDX_MASK) - 1.0; // memberIdx
        result.entries[o + 1u] = wt.w;       // waveId (float-exact counter value)
        result.entries[o + 2u] = contact.x;
        result.entries[o + 3u] = contact.y;
        result.entries[o + 4u] = contact.z;
        if(uStarfallEnabled)result.entries[o+5u]=hitTime;
        return; // one report per member thread
    }
}

layout(local_size_x=64) in;
layout(std430,binding=1) buffer Pool {vec4 data[];} writeBuf;
layout(std430,binding=3) buffer Counter {uint writeSlot;} counter;
uniform uint uCapacity,uCount,uEmitter;uniform vec3 uPlayer,uCamPos;uniform float uTop,uSeed;
uniform vec4 uFrustum[6];
#pragma cmi_include chunks/pool_reservation.glsl
#pragma cmi_include chunks/feather_state.glsl
#pragma cmi_include chunks/feather_record.glsl
#pragma cmi_include chunks/storm_collision.glsl
void main(){
    uint index=gl_GlobalInvocationID.x;if(index>=uCount)return;
    float seed=uSeed+float(index)*317.;vec3 p=vec3(0);bool accepted=false;
    for(int attempt=0;attempt<8;attempt++){
        float s=seed+float(attempt)*91.7,a=cmiFeatherHash(s)*6.2831853;
        float r=sqrt(mix(36.,576.,cmiFeatherHash(s+1.)));

 for(int x=lo.x;x<=hi.x;x++)for(int y=lo.y;y<=hi.y;y++)for(int z=lo.z;z<=hi.z;z++){
  ivec3 cell=ivec3(x,y,z);int page=cmiStormLookupPage(cell>>4);
  if(page==-1||page==-3||(page>=0&&cmiStormSolidInPage(cell,page)))return false;
 }

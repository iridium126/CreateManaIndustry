// ABI 10 experiment. All gameplay state remains in the current production pool.
layout(local_size_x=256) in;
struct Row {vec4 position;vec4 velocity;uvec4 identity;vec4 preferred;};
layout(std430,binding=0) buffer Pool {vec4 data[];} pool;
layout(std430,binding=3) readonly buffer Count {uint live;} count;
layout(std430,binding=5) readonly buffer Emitters {vec4 data[];} emitters;
layout(std430,binding=6) buffer Snapshot {uint header[32];Row rows[];} snapshot;
layout(std430,binding=7) buffer Alternate {uint header[32];Row rows[];} alternate;
layout(std430,binding=8) buffer Metadata {uvec4 data[];} metadata;
layout(std430,binding=9) buffer Grid {int heads[262144];int next[];} grid;
layout(std430,binding=28) readonly buffer CurrentState {uint data[];} state;
uniform uint phase,capacity,poolCapacity;
uniform uvec2 nonce,epoch,generation,scene;
uniform float timeSec,dt;
uniform bool stateEnabled;
layout(r32ui,binding=4) readonly uniform uimageBuffer avoidanceMotionCaps;
uniform bool motionCapsEnabled;
#pragma cmi_include ../chunks/storm_collision.glsl
uint hashCell(ivec3 c){return (uint(c.x)*92837111u^uint(c.y)*689287499u^uint(c.z)*283923481u)&262143u;}
bool finite3(vec3 p){return !any(isnan(p))&&!any(isinf(p));}
bool clearSweep(vec3 a,vec3 b){
 if(!uStormCollisionEnabled||!uStormCollisionOn)return false;
 if(cmiStormAirSweep(a,b))return true;

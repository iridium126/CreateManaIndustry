#version 450 core
layout(local_size_x=256)in;
layout(std430,binding=0)readonly buffer Pool{vec4 data[];}pool;
layout(std430,binding=14)readonly buffer Previous{uint live;}previous;
layout(std430,binding=24)readonly buffer Population{uint modelCount,stormCount,populationLive,valid;uvec2 generation;uint modelCapacity,stormCapacity;uint slots[];}population;
layout(std430,binding=15)buffer Output{uvec4 header[4];vec4 records[];}outputData;
uniform uint uRecordCapacity,uPhase;
uniform uvec2 uInputGeneration;
void main(){
 uint i=gl_GlobalInvocationID.x,count=population.stormCount;
 bool ok=population.valid==1u&&population.generation==uInputGeneration&&population.populationLive==previous.live&&population.modelCount<=population.modelCapacity&&count<=population.stormCapacity&&count<=uRecordCapacity&&population.modelCapacity<=uint(population.slots.length())/2u;
 if(ok)ok=count<=uint(population.slots.length())-population.modelCapacity*2u;
 if(uPhase==0u){if(i==0u){outputData.header[0]=uvec4(count,ok?1u:0u,uInputGeneration);outputData.header[1]=uvec4(previous.live,population.modelCount,uRecordCapacity,32u);outputData.header[2]=uvec4(0);outputData.header[3]=uvec4(0);}return;}
 if(!ok||i>=count)return;uint slot=population.slots[population.modelCapacity*2u+i];
 if(slot>=previous.live||slot*4u+3u>=uint(pool.data.length())){atomicExchange(outputData.header[0].y,0u);return;}
 vec4 pos=pool.data[slot*4u],velocity=pool.data[slot*4u+1u];
 outputData.records[i*2u]=vec4(pos.xyz,uintBitsToFloat((uint(pos.w+.5)&262143u)-1u));
 outputData.records[i*2u+1u]=vec4(velocity.xyz,uintBitsToFloat(slot));
}

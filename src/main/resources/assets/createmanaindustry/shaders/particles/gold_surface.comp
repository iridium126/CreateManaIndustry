layout(local_size_x=64) in;
layout(std430,binding=9) buffer Surface {uint words[];} surface;
#pragma cmi_include chunks/surface_state.glsl
uniform uint uSurfacePhase,uSurfaceCount,uSurfacePatchStart;uniform vec2 uSurfaceCenter;uniform float uSurfaceRadius;
uniform ivec2 uSurfaceOrigin;uniform int uSurfaceTop;
#pragma cmi_include chunks/storm_collision.glsl
uint cmiSurfaceWord(int page,uint word){
    if(page==-2)return 0u;
    if(page==-3)return 0xffffffffu;
    ivec3 texel=ivec3((page&31)*4+int(word&3u),((page>>5)&31)*4+int((word>>2u)&3u),(page>>10)*8+int(word>>4u));
    return texelFetch(uStormCollisionAtlas,texel,0).r;
}
shared int abovePage;
void main(){
    if(uSurfacePhase==1u){
        uint at=CMI_SURFACE_PATCH+gl_WorkGroupID.x*4u;ivec2 tile=ivec2(surface.words[at],surface.words[at+1u]);uint t=cmiSurfaceTile(tile),meta=CMI_SURFACE_TILE+t*4u;
        bool clear=surface.words[at+3u]!=0u||any(notEqual(ivec2(surface.words[meta],surface.words[meta+1u]),tile))||int(surface.words[meta+3u])!=uSurfaceTop;
        for(uint i=gl_LocalInvocationID.x;i<256u;i+=64u){uint c=cmiSurfaceCell(tile*16+ivec2(int(i&15u),int(i>>4u)));if(clear||(surface.words[c]&0x80000000u)!=0u)surface.words[c]=0u;}
        barrier();if(gl_LocalInvocationID.x==0u){surface.words[meta]=uint(tile.x);surface.words[meta+1u]=uint(tile.y);surface.words[meta+2u]=surface.words[at+2u];surface.words[meta+3u]=uint(uSurfaceTop);atomicOr(surface.words[CMI_SURFACE_DIRTY+(t>>5u)],1u<<(t&31u));}return;
    }
    if(uSurfacePhase==2u){
        uint word=gl_GlobalInvocationID.x,mask=0u;
        for(uint bit=0u;bit<32u;bit++){uint c=word*32u+bit;ivec2 local=ivec2(int(c&255u),int(c>>8u));uint t=cmiSurfaceTile(local>>4),meta=CMI_SURFACE_TILE+t*4u;
            ivec2 world=ivec2(surface.words[meta],surface.words[meta+1u])*16+(local&15);vec2 d=max(vec2(0.),max(vec2(world)-uSurfaceCenter,uSurfaceCenter-(vec2(world)+1.)));
            if(surface.words[meta+2u]!=0u&&surface.words[c]==0u&&dot(d,d)<uSurfaceRadius*uSurfaceRadius)mask|=1u<<bit;
        }surface.words[CMI_SURFACE_MISSING+word]=mask;return;
    }
    if(uSurfacePhase==3u){uint i=gl_GlobalInvocationID.x;if(i>=uSurfaceCount)return;uint at=CMI_SURFACE_PATCH+(i+uSurfacePatchStart)*4u,c=surface.words[at],t=cmiSurfaceTile(ivec2(int(c&255u),int(c>>8u))>>4);
        if(surface.words[CMI_SURFACE_TILE+t*4u+2u]==surface.words[at+2u]&&(surface.words[c]&0x80000000u)==0u)surface.words[c]=surface.words[at+1u];return;
    }
    uint row=gl_WorkGroupID.x+gl_NumWorkGroups.x*gl_WorkGroupID.y;if(!uStormCollisionOn||row>uStormCollisionMask)return;
    ivec4 entry=texelFetch(uStormCollisionTable,int(row));if(entry.w==-1||entry.w==-2)return;
    ivec3 origin=entry.xyz*16;uint t=cmiSurfaceTile(entry.xz),meta=CMI_SURFACE_TILE+t*4u;
    if(origin.y>=uSurfaceTop||(surface.words[CMI_SURFACE_DIRTY+(t>>5u)]&(1u<<(t&31u)))==0u||any(notEqual(ivec2(surface.words[meta],surface.words[meta+1u]),entry.xz)))return;
    if(gl_LocalInvocationID.x==0u)abovePage=cmiStormLookupPage(entry.xyz+ivec3(0,1,0));barrier();
    for(uint word=gl_LocalInvocationID.x;word<128u;word+=64u){
        if(entry.w==-3&&word<120u)continue; // Compressed SOLID pages expose only their upper face.
        int top=origin.y+int(word>>3u)+1;if(top>uSurfaceTop)continue;
        uint current=cmiSurfaceWord(entry.w,word);if(current==0u)continue;
        uint above;
        if(word<120u)above=cmiSurfaceWord(entry.w,word+8u);
        else{if(abovePage==-1||abovePage==-3)continue;above=cmiSurfaceWord(abovePage,word&7u);}
        uint exposed=current&~above;
        while(exposed!=0u){uint bit=uint(findLSB(exposed));exposed&=exposed-1u;uint cell=word*32u+bit;
            ivec2 p=origin.xz+ivec2(int(cell&15u),int((cell>>4u)&15u));atomicMax(surface.words[cmiSurfaceCell(p)],cmiSurfacePack(top));
        }
    }
}

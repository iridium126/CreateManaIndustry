layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Inputs {vec4 data[];} inputs;
layout(std430,binding=1) readonly buffer Jobs {vec4 data[];} jobs;
layout(std430,binding=5) buffer OutputPool {vec4 data[];} particles;
uniform uint uEmitter;
uniform float uFadeDistance,uViewportHeight;
uniform mat4 uView,uProjection;
float hash(float n){return fract(sin(n*12.9898)*43758.5453);}
float glowAt(float age,bool animate){return animate?mix(.2,1.0,1.0-pow(1.0-clamp(age/.35,0.0,1.0),3.0)):1.0;}
void main(){
    uint idx=gl_WorkGroupID.x,base=idx*4u,domain=idx/18u;
    vec4 timing=inputs.data[domain*4u+2u];
    bool edge=idx%18u<12u,stopping=timing.y>=0.0;
    float age=stopping?timing.x-timing.y:timing.x;
    float envelope=glowAt(age,timing.z>.5)*(stopping?1.0-smoothstep(0.0,.8,timing.y):1.0);
    uint count=floatBitsToUint(jobs.data[base+2u].w),offset=floatBitsToUint(jobs.data[base+1u].w);
    for(uint i=gl_LocalInvocationID.x;i<count;i+=64u){
        float key=timing.w+float(idx%18u)*71.7+float(i)*1.37;
        vec2 uv=edge?vec2((float(i)+.5)/float(count),0):vec2((float(i)+.5)/float(count),fract(float(i)*.61803398875));
        vec3 pos=jobs.data[base].xyz+jobs.data[base+1u].xyz*uv.x+jobs.data[base+2u].xyz*uv.y;
        if(!edge)pos+=(vec3(hash(key),hash(key+3.0),hash(key+7.0))-.5)*.008;
        if(stopping)pos+=(vec3(hash(key+13.0)-.5,.3+hash(key+17.0)*.5,hash(key+19.0)-.5))*.3*timing.y;
        float highlight=hash(key+29.0)<.05?1.15+.15*sin(age*1.5+key):1.0;
        vec3 color=highlight>1.01?vec3(232,247,255)/255.0:vec3(184,228,255)/255.0;
        float fade=1.0-smoothstep(uFadeDistance*.8,uFadeDistance,length(pos));
        float depth=max(.1,-(uView*vec4(pos,1.0)).z);
        float diameter=max(edge?.025:.14,1.25*depth/(max(.01,abs(uProjection[1][1]))*max(1.0,uViewportHeight)))*(stopping?1.0-.5*smoothstep(0.0,.8,timing.y):1.0);
        uint dst=(offset+i)*4u;
        particles.data[dst]=vec4(pos,diameter);particles.data[dst+1u]=vec4(0,0,0,hash(key+5.0)*6.2831853);
        particles.data[dst+2u]=vec4(color,envelope*fade*highlight*(edge?.65:.07));
        particles.data[dst+3u]=vec4(0,0,key,uintBitsToFloat(uEmitter));
    }
}

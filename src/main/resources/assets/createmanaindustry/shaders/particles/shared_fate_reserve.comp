// Only allocation is ordered. Curve work runs in parallel in the prepare pass.
layout(local_size_x=1) in;
layout(std430,binding=0) readonly buffer Inputs{vec4 entries[];} inputData;
layout(std430,binding=1) buffer Jobs{vec4 entries[];} jobs;
layout(std430,binding=3) buffer NextState{vec4 entries[];} nextState;
layout(std430,binding=4) buffer Counter{uint live;uint spare;uint census;uint sorted;} counter;
uniform uint uCount,uCapacity,uBudget;
void main(){
    uint offset=min(counter.live,uCapacity),available=min(uBudget,uCapacity-offset);
    uint wanted=0u;for(uint i=0u;i<uCount;i++)wanted+=floatBitsToUint(jobs.entries[i*5u+1u].w);
    float density=min(1.0,float(available)/float(max(1u,wanted)));
    for(uint i=0u;i<uCount;i++){
        uint base=i*5u,requested=floatBitsToUint(jobs.entries[base+1u].w);
        uint count=requested==0u?0u:min(available,min(requested,max(16u,uint(ceil(float(requested)*density)))));
        jobs.entries[base].w=uintBitsToFloat(offset);
        jobs.entries[base+1u].w=uintBitsToFloat(count);
        if(inputData.entries[base+2u].z<.5){
            uint slot=floatBitsToUint(inputData.entries[base+3u].x)*5u;
            jobs.entries[base+2u].w=float(count);nextState.entries[slot+2u].z=float(count);
        }
        offset+=count;available-=count;
    }
    counter.live=offset;
}

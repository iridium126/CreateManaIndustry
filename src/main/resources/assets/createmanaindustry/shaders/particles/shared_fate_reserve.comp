// Reserve complete four-strand ribbons before glow and decoration.
layout(local_size_x=1) in;
layout(std430,binding=0) readonly buffer Inputs{vec4 entries[];} inputData;
layout(std430,binding=1) buffer Jobs{vec4 entries[];} jobs;
layout(std430,binding=2) readonly buffer PreviousState{vec4 entries[];} previous;
layout(std430,binding=3) buffer NextState{vec4 entries[];} nextState;
layout(std430,binding=4) buffer Counter{uint live;uint spare;uint census;uint sorted;} counter;
uniform uint uCount,uCapacity,uBudget;
#pragma cmi_include chunks/shared_fate_sampling.glsl
void main(){
    uint available=min(uBudget,uCapacity-min(counter.live,uCapacity)),nodes=0u;
    for(uint i=0u;i<uCount;i++){
        uint jb=i*CMI_FATE_VECTORS;bool enabledLink=floatBitsToUint(jobs.entries[jb+1u].w)!=0u;
        uint n=enabledLink?uint(jobs.entries[jb+6u].w+.5):0u;
        while(n>16u&&4u*n>available)n/=2u;
        if(n>0u&&4u*n>available)n=0u;
        uint slot=floatBitsToUint(inputData.entries[i*5u+3u].x)*CMI_FATE_VECTORS;
        float fade=jobs.entries[jb+9u].z>.5?cmiFateSmooth(previous.entries[slot+5u].w,n>0u?1.0:0.0,jobs.entries[jb+8u].z):(n>0u?1.0:0.0);
        jobs.entries[jb+5u].w=fade;
        jobs.entries[jb+6u].w=float(n);jobs.entries[jb+9u].x=uintBitsToFloat(nodes);
        jobs.entries[jb+19u]=vec4(float(4u*n),0,0,0);
        if(n>0u)nodes+=4u*(n+1u);
        available-=4u*n;
        if(n>0u&&float(n)<exp2(ceil(jobs.entries[jb+8u].x-.00001)))jobs.entries[jb+8u].x=log2(float(n));
    }
    // Glow is coherent across each whole curve: either all its segments exist or none do.
    for(uint i=0u;i<uCount;i++){
        uint jb=i*CMI_FATE_VECTORS,n=uint(jobs.entries[jb+19u].x+.5);
        if(n>0u&&n<=available){jobs.entries[jb+19u].y=float(n);available-=n;}
    }
    for(uint i=0u;i<uCount;i++){
        uint jb=i*CMI_FATE_VECTORS,n=uint(jobs.entries[jb+19u].x+.5);if(n==0u)continue;
        uint fragments=min(available,uint(jobs.entries[jb+7u].y+.5));
        jobs.entries[jb+19u].w=float(fragments);available-=fragments;
    }
    for(uint i=0u;i<uCount;i++){
        uint jb=i*CMI_FATE_VECTORS,n=uint(jobs.entries[jb+19u].x+.5);if(n==0u)continue;
        uint stars=min(available,uint(jobs.entries[jb+7u].x+.5));
        jobs.entries[jb+19u].z=float(stars);available-=stars;
    }
    uint offset=min(counter.live,uCapacity);
    for(uint i=0u;i<uCount;i++){
        uint jb=i*CMI_FATE_VECTORS,sb=floatBitsToUint(inputData.entries[i*5u+3u].x)*CMI_FATE_VECTORS;
        vec4 counts=jobs.entries[jb+19u];uint count=uint(counts.x+counts.y+counts.z+counts.w+.5);
        jobs.entries[jb].w=uintBitsToFloat(offset);jobs.entries[jb+1u].w=uintBitsToFloat(count);offset+=count;
        nextState.entries[sb+5u].w=jobs.entries[jb+5u].w;
        nextState.entries[sb+8u].x=jobs.entries[jb+8u].x;
        nextState.entries[sb+6u].w=jobs.entries[jb+6u].w;
    }
    counter.live=offset;
}

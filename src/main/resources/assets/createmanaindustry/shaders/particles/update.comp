                    if(streak==3u){atomicAdd(CMI_STATE(starStateWrite,counts),1u);atomicOr(CMI_STATE(starStateWrite,CMI_GATHER_READY+word),bit);}
                }
            }else if(cmiDome(b)&&phase>=6.&&cmiStarVec(b+20u).y==1.){
                uint word=cmiStarSlot(a)*384u+cmiMajorRank(a)/32u,bit=1u<<(cmiMajorRank(a)&31u);
                atomicAnd(CMI_STATE(starStateWrite,CMI_GATHER_READY+word),~bit);
                if((atomicAnd(CMI_STATE(starStateWrite,CMI_GATHER_ELIGIBLE+word),~bit)&bit)!=0u)atomicAdd(CMI_STATE(starStateWrite,CMI_GATHER_COUNTS+cmiStarSlot(a)*4u+1u),0xffffffffu);
            }else if(cmiDome(b)&&phase==4.){
                streak=CMI_STATE(starStateWrite,CMI_GATHER_STREAK+member);
                blockedSeconds=cmiTerrainClipped?blockedSeconds+uDt:0.;
                if(blockedSeconds>=.5){
                    uint rank=cmiMajorRank(a),word=cmiStarSlot(a)*384u+rank/32u;
                    CMI_DOME_COMPLETE(starStateWrite,member,word,1u<<(rank&31u),false,roll);
                    blockedSeconds=0.;streak=0u;
                }
            }
            // Released members own this scratch for velocity/pose handoff.
            if(phase<6.){CMI_STATE(starStateWrite,CMI_GATHER_BLOCKED+member)=floatBitsToUint(blockedSeconds);if(!cmiDome(b)||phase!=1.)CMI_STATE(starStateWrite,CMI_GATHER_STREAK+member)=streak;}
        }
    }}

    if(corpse&&stormA.x>.5&&uStarfallEnabled){uint a=cmiStarAssignment(p0.w),member=cmiStarMember(p0.w);if(a!=0u&&cmiStarSlot(a)<4u){uint b=cmiStarBase(cmiStarSlot(a));if((cmiHelix(b)||cmiDome(b))&&cmiStarVec(b+20u).y<3.){uint word=cmiStarSlot(a)*384u+cmiMajorRank(a)/32u,bit=1u<<(cmiMajorRank(a)&31u);if((atomicAnd(CMI_STATE(starStateWrite,CMI_GATHER_ELIGIBLE+word),~bit)&bit)!=0u)atomicAdd(CMI_STATE(starStateWrite,CMI_GATHER_COUNTS+cmiStarSlot(a)*4u+1u),0xffffffffu);if(cmiDome(b)){CMI_STATE(starStateWrite,cmiDomePathRecord(a)+1u)=0u;if((atomicAnd(CMI_STATE(starStateWrite,CMI_DOME_PATH_REQUESTS+member/32u),~(1u<<(member&31u)))&(1u<<(member&31u)))!=0u)atomicAdd(CMI_STATE(starStateWrite,CMI_DOME_PATH_CONTROL+1u),0xffffffffu);uint window=CMI_DOME_GATHER_WINDOW+(cmiStarSlot(a)*12288u+cmiMajorRank(a))*8u;for(uint component=0u;component<8u;component++)CMI_STATE(starStateWrite,window+component)=0u;}}}}

    // DIE_ON_GROUND (cherry): vanilla removes the particle in the same tick it
    // touches ground — BEFORE the frame renders, so the landing position is
    // never drawn (the last rendered frame is the one before touchdown).
    // Skipping the output write below does exactly that: the particle compacts
    // out this frame. hp holds maxLife for non-MODEL materials; MODEL never
    // uses DIE_ON_GROUND (corpses expire through the countdown instead).
    if (!isModel && collideMode > 1.5 && landed)
        return;
    // corpse countdown advances AFTER the age bookkeeping; the hurt overlay
    // decays over vanilla's hurtTime (10 ticks = 0.5 s)
    if (isModel) {
        if (corpse)
            hp -= uDt;
        hurt = max(0.0, hurt - 2.0 * uDt);
    }

    // Publish once per simulation frame. Drawing and shadow collection never integrate pose.
    if(stormA.x>.5&&uDomePoseStorageEnabled){uint member=cmiStarMember(p0.w),a=cmiStarAssignment(p0.w);
        if(member<131072u&&CMI_DOME_POSE+member*2u+1u<uint(starStateWrite.words.length())){
            uint at=CMI_DOME_POSE+member*2u,flags=CMI_STATE(starStateRead,at+1u);
            uint lifecycle=CMI_STATE(starStateWrite,member*2u+1u),actualPhase=lifecycle&255u;
            bool same=CMI_STATE(starStateRead,member*2u)==CMI_STATE(starStateWrite,member*2u);
            bool valid=same&&(flags&0x80000000u)!=0u;
            bool ordinaryOwner=a==0u||!cmiColumnAssignment(a);
            bool domeOwner=a!=0u&&cmiStarSlot(a)<4u&&cmiDome(cmiStarBase(cmiStarSlot(a)));
            bool current=!corpse&&domeOwner&&actualPhase<6u;
            bool localReturn=cmiNavigationApplied&&cmiNavigationCurrentMember==member&&actualPhase==6u&&CMI_STATE(starStateWrite,cmiNavigationExtra(member))==2u;
            bool returning=!corpse&&ordinaryOwner&&actualPhase>=6u&&CMI_STATE(starStateWrite,member*2u)!=0u&&(valid||localReturn);
            if(current||returning){
                float initialYaw=cmiHash1(p3.z*3.7)*6.28318530718;
                bool previousPose=valid;
                vec2 angles=previousPose?cmiDomeUnpackPose(CMI_STATE(starStateRead,at)):vec2(length(p1.xz)>.05?atan(p1.x,p1.z):-initialYaw,length(p1.xyz)>.0001?asin(clamp(p1.y/length(p1.xyz),-1.,1.)):0.);
                float previousCarry=returning&&!previousPose?cmiAttackCarry(p0.w,uTimeSec-uDt,p1.w):0.;
                if(returning&&!previousPose&&a!=0u){uint b=cmiStarBase(cmiStarSlot(a));float time=cmiStarTime(b,uTimeSec-uDt);if(cmiHelix(b)&&previousCarry>0.&&(cmiHelixPhase(b,time)!=4.||length(p1.xz)<.05))angles.x=1.570796327-cmiHelixHeading(b,time);}
                if(returning&&!previousPose&&uAllayAnimationWriteEnabled){uvec4 prior=cmiAnimationReadRow(animationSlot*4u),meta=cmiAnimationReadRow(animationSlot*4u+2u);if((meta.z&0x80000000u)!=0u){vec2 before=cmiAnimationAngles(prior.x),after=cmiAnimationAngles(prior.y);angles.x=-(before.x+cmiAnimationAngle(before.x,after.x)*(uAllayAnimationAlpha>=0.?uAllayAnimationAlpha:clamp(p3.x*20.-float(meta.w),0.,1.)));}}
                vec2 previousAngles=angles;
                vec3 navigation=current&&cmiStarPhase(a,uTimeSec)==4.?cmiDomePoseTangent:vel;
                angles=cmiDomeAdvancePose(angles,navigation,uDt);
                float blend=previousPose?float(flags&65535u)/65535.:previousCarry;
                blend=mix(blend,current&&roll< -3.5&&roll> -4.5?1.:0.,1.-exp(-uDt/.12));
                float poseSpeed=previousPose?float((flags>>16u)&32767u)*(64./32767.):length(p1.xyz);
                poseSpeed=mix(poseSpeed,length(vel),1.-exp(-uDt/.12));
                bool keepPose=true;
                uint phase=actualPhase;
                // Only actual local navigation starts/retains a generic return
                // pose. A clear corridor fades it out even before arrival.
                bool domeReturn=domeOwner||(lifecycle&0x100u)!=0u;
                bool fading=returning&&(phase>=7u||(!domeReturn&&!localReturn));
                if(returning&&!fading)CMI_STATE(starStateWrite,CMI_GATHER_STREAK+member)=0u;
                if(fading){
                    // Existing contact scratch is unused by arrived members.
                    // Fade the cached offsets onto the current ordinary pose,
                    // including when the last attack has already disappeared.
                    uint scratch=CMI_DOME_CONTACT_DELTA+member*4u;
                    float ordinarySpeed=length(vel),ordinaryYaw=length(vel.xz)>.05?atan(vel.x,vel.z):-cmiHash1(p3.z*3.7)*6.28318530718,ordinaryPitch=ordinarySpeed>.0001?asin(clamp(vel.y/ordinarySpeed,-1.,1.)):0.;
                    bool fresh=!valid||(CMI_STATE(starStateRead,CMI_GATHER_STREAK+member)&0x80000000u)==0u;
                    vec4 offsets;float elapsed;
                    if(fresh){offsets=vec4(mod(previousAngles.x-ordinaryYaw+3.141592654,6.28318530718)-3.141592654,previousAngles.y-ordinaryPitch,(previousPose?float((flags>>16u)&32767u)*(64./32767.):length(p1.xyz))-ordinarySpeed,previousPose?float(flags&65535u)/65535.:previousCarry);elapsed=0.;}
                    else{offsets=vec4(uintBitsToFloat(CMI_STATE(starStateRead,scratch)),uintBitsToFloat(CMI_STATE(starStateRead,scratch+1u)),uintBitsToFloat(CMI_STATE(starStateRead,scratch+2u)),uintBitsToFloat(CMI_STATE(starStateRead,scratch+3u)));elapsed=uintBitsToFloat(CMI_STATE(starStateRead,CMI_GATHER_BLOCKED+member))+uDt;}
                    for(uint k=0u;k<4u;k++)CMI_STATE(starStateWrite,scratch+k)=floatBitsToUint(offsets[k]);CMI_STATE(starStateWrite,CMI_GATHER_STREAK+member)=0x80000000u;CMI_STATE(starStateWrite,CMI_GATHER_BLOCKED+member)=floatBitsToUint(elapsed);
                    float u=clamp(elapsed/.5,0.,1.),fade=1.-u*u*u*(10.-15.*u+6.*u*u);
                    angles=cmiDomePoseAngles(previousAngles,ordinaryYaw+offsets.x*fade,ordinaryPitch+offsets.y*fade,uDt,0.);poseSpeed=max(0.,ordinarySpeed+offsets.z*fade);blend=offsets.w*fade;
                    float error=abs(mod(angles.x-ordinaryYaw+3.141592654,6.28318530718)-3.141592654)+abs(angles.y-ordinaryPitch);

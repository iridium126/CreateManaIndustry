                }
                CMI_STATE(starStateWrite,at)=cmiDomePackPose(angles);CMI_STATE(starStateWrite,at+1u)=(keepPose?0x80000000u:0u)|uint(round(clamp(blend,0.,1.)*65535.))|(uint(round(clamp(poseSpeed/64.,0.,1.)*32767.))<<16u);
            }else{CMI_STATE(starStateWrite,at)=CMI_STATE(starStateRead,at);CMI_STATE(starStateWrite,at+1u)=0u;}
        }
    }
    uint slot = cmiReserveParticle();
    if (slot >= uCapacity) {if(uModelPass==2u)cmiModelRetire(animationSlot);return;}

    if (isModel && stormA.x < 0.5) cmiCopyIdentity(idx, slot);
    if(uModelPass==2u)cmiModelAppend(slot,animationSlot,stormA.x>.5);
    if(isModel&&stormA.x>.5&&uDomePoseStorageEnabled){
        uint member=cmiStarMember(p0.w);
        if(member<131072u){uint extra=cmiNavigationExtra(member),mask=CMI_DEPEN_MASK+member/32u,bit=1u<<(member&31u);
            bool pending=(CMI_STATE(starStateWrite,mask)&bit)!=0u;

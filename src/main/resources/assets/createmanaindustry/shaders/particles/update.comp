                bool fresh=!pending||CMI_STATE(starStateRead,member*2u)!=CMI_STATE(starStateWrite,member*2u);
                if(fresh){CMI_STATE(starStateWrite,extra+3u)=floatBitsToUint(uTimeSec);CMI_STATE(starStateWrite,extra+11u)=floatBitsToUint(uTimeSec);}
                CMI_STATE(starStateWrite,extra+1u)=slot+1u;CMI_STATE(starStateWrite,extra+15u)=uStormFrame;
                if(!pending){atomicOr(CMI_STATE(starStateWrite,mask),bit);atomicAdd(CMI_STATE(starStateWrite,CMI_DEPEN_CONTROL+9u),1u);}
                roll=0.;CMI_STATE(starStateWrite,CMI_GATHER_STREAK+member)=0u;
            }else if(pending){atomicAnd(CMI_STATE(starStateWrite,mask),~bit);atomicAdd(CMI_STATE(starStateWrite,CMI_DEPEN_CONTROL+9u),0xffffffffu);}
        }
    }
    uint wb = slot * 4u;
    writeBuf.data[wb + 0u] = vec4(pos, waveContactLatched
            ? p0.w + float(MEMBER_LATCH_BIT)
            : p0.w);
    writeBuf.data[wb + 1u] = vec4(vel, roll);
    writeBuf.data[wb + 2u] = vec4(p2.rgb, hurt);
    writeBuf.data[wb + 3u] = vec4(age, hp, p3.z, p3.w);
    cmiType_update(uint(emitters.u[hb].x), hb, writeBuf.data[wb], writeBuf.data[wb+1u],
                   writeBuf.data[wb+2u], writeBuf.data[wb+3u]);
}

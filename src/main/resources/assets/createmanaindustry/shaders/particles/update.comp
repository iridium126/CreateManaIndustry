            uint at=CMI_DOME_POSE+member*2u,flags=starStateRead.words[at+1u];
            uint actualPhase=starStateWrite.words[member*2u+1u]&255u;
            bool domeOwner=a!=0u&&cmiStarSlot(a)<4u&&cmiDome(cmiStarBase(cmiStarSlot(a)));
            bool current=domeOwner&&actualPhase<6u;
            bool returning=(a==0u||domeOwner)&&actualPhase>=6u&&(flags&0x80000000u)!=0u;
            if(current||returning){
                float initialYaw=cmiHash1(p3.z*3.7)*6.28318530718+p3.x*.3;
                vec2 angles=(flags&0x80000000u)!=0u?cmiDomeUnpackPose(starStateRead.words[at]):vec2(length(p1.xz)>.05?atan(p1.x,p1.z):-initialYaw,length(p1.xyz)>.0001?asin(clamp(p1.y/length(p1.xyz),-1.,1.)):0.);
                vec3 navigation=current&&cmiStarPhase(a,uTimeSec)==4.?cmiDomePoseTangent:vel;
                angles=cmiDomeAdvancePose(angles,navigation,uDt);
                float blend=(flags&0x80000000u)!=0u?float(flags&65535u)/65535.:0.;
                blend=mix(blend,roll< -3.5&&roll> -4.5?1.:0.,1.-exp(-uDt/.12));
                float poseSpeed=(flags&0x80000000u)!=0u?float((flags>>16u)&32767u)*(64./32767.):length(p1.xyz);
                poseSpeed=mix(poseSpeed,length(vel),1.-exp(-uDt/.12));
                bool keepPose=true;
                uint phase=actualPhase;
                if(returning&&phase>=7u){
                    // Existing contact scratch is unused by arrived members.
                    // Fade the cached offsets onto the current ordinary pose,
                    // including when the last attack has already disappeared.
                    uint scratch=CMI_DOME_CONTACT_DELTA+member*4u;
                    float ordinarySpeed=length(vel),ordinaryYaw=length(vel.xz)>.05?atan(vel.x,vel.z):-(cmiHash1(p3.z*3.7)*6.28318530718+age*.3),ordinaryPitch=ordinarySpeed>.0001?asin(clamp(vel.y/ordinarySpeed,-1.,1.)):0.;
                    bool fresh=(starStateRead.words[CMI_GATHER_STREAK+member]&0x80000000u)==0u;
                    vec4 offsets;float elapsed;
                    if(fresh){vec2 previous=cmiDomeUnpackPose(starStateRead.words[at]);float yaw=previous.x;offsets=vec4(mod(yaw-ordinaryYaw+3.141592654,6.28318530718)-3.141592654,previous.y-ordinaryPitch,float((flags>>16u)&32767u)*(64./32767.)-ordinarySpeed,float(flags&65535u)/65535.);elapsed=0.;}
                    else{offsets=vec4(uintBitsToFloat(starStateRead.words[scratch]),uintBitsToFloat(starStateRead.words[scratch+1u]),uintBitsToFloat(starStateRead.words[scratch+2u]),uintBitsToFloat(starStateRead.words[scratch+3u]));elapsed=uintBitsToFloat(starStateRead.words[CMI_GATHER_BLOCKED+member])+uDt;}
                    for(uint k=0u;k<4u;k++)starStateWrite.words[scratch+k]=floatBitsToUint(offsets[k]);starStateWrite.words[CMI_GATHER_STREAK+member]=0x80000000u;starStateWrite.words[CMI_GATHER_BLOCKED+member]=floatBitsToUint(elapsed);
                    float u=clamp(elapsed/.5,0.,1.),fade=1.-u*u*u*(10.-15.*u+6.*u*u);
                    angles=cmiDomePoseAngles(cmiDomeUnpackPose(starStateRead.words[at]),ordinaryYaw+offsets.x*fade,ordinaryPitch+offsets.y*fade,uDt,0.);poseSpeed=max(0.,ordinarySpeed+offsets.z*fade);blend=offsets.w*fade;
                    float error=abs(mod(angles.x-ordinaryYaw+3.141592654,6.28318530718)-3.141592654)+abs(angles.y-ordinaryPitch);
                    keepPose=elapsed<.5||error>.001;
                }
                starStateWrite.words[at]=cmiDomePackPose(angles);starStateWrite.words[at+1u]=(keepPose?0x80000000u:0u)|uint(round(clamp(blend,0.,1.)*65535.))|(uint(round(clamp(poseSpeed/64.,0.,1.)*32767.))<<16u);
            }else{starStateWrite.words[at]=starStateRead.words[at];starStateWrite.words[at+1u]=0u;}
        }
    }
    uint slot = cmiReserveParticle();
    if (slot >= uCapacity)
        return;

    if (isModel && stormA.x < 0.5) cmiCopyIdentity(idx, slot);
    uint wb = slot * 4u;
    writeBuf.data[wb + 0u] = vec4(pos, waveContactLatched
            ? p0.w + float(MEMBER_LATCH_BIT)
            : p0.w);
    writeBuf.data[wb + 1u] = vec4(vel, roll);
    writeBuf.data[wb + 2u] = vec4(p2.rgb, hurt);
    writeBuf.data[wb + 3u] = vec4(age, hp, p3.z, p3.w);
    cmiType_update(uint(emitters.u[hb].x), hb, writeBuf.data[wb], writeBuf.data[wb+1u],
                   writeBuf.data[wb+2u], writeBuf.data[wb+3u]);
}

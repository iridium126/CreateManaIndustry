    vec3 accel = emitters.u[hb + 3u].xyz;
    float windStrength = emitters.u[hb + 3u].w;
    vec3 windDir = emitters.u[hb + 4u].xyz;

    vec3 pos = p0.xyz;
    vec3 vel = p1.xyz;

#pragma cmi_include chunks/model_damage.glsl

    bool corpse = isModel && hp <= 0.0;

#pragma cmi_include chunks/basic_motion.glsl

#pragma cmi_include chunks/storm_motion.glsl


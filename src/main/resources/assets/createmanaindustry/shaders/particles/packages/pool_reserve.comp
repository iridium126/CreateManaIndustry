layout(local_size_x=1) in;
layout(std430,binding=3) buffer Counter { uint live; uint spare; uint translucent; uint sorted; };
layout(std430,binding=6) buffer Reservation { uint base; uint accepted; uint requested; uint reserved; };
uniform uint uCapacity, uCount;
layout(std430,binding=7) readonly buffer Selection { uint validCount; uint pad0; uint pad1; uint pad2; uint selected[]; };
void main() {
    base=min(live,uCapacity);
    accepted=min(validCount,uCapacity-base);
    requested=uCount;
    live=base+accepted;
}

#pragma cmi_include packages/state.glsl
#pragma cmi_include packages/sweep_cells.glsl
layout(std430,binding=7) buffer FastCells { SweepCell fastCells[]; };
layout(std430,binding=8) buffer LongSweepBodies { uint longBodyCount; uint longBodies[]; };
layout(local_size_x=64) in;
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
    Body b=src[i];if(b.positionMass.w<=0.0||b.previousSleep.w<0.0)return;
    vec3 motion=b.positionMass.xyz-b.previousSleep.xyz;
    if(all(lessThanEqual(abs(motion),max(b.extentYaw.xyz,vec3(1e-5)))))return;
    // Record actual local motion bounds wherever a fast trajectory can meet a
    // query. Very long or diagonal paths use a compact body list and are checked
    // through the exact fallback instead of touching a huge cell cube.
    vec3 padding=b.extentYaw.xyz+vec3(uCellSize+1e-4);
    ivec3 lo=cellOf(min(b.previousSleep.xyz,b.positionMass.xyz)-padding);
    ivec3 hi=cellOf(max(b.previousSleep.xyz,b.positionMass.xyz)+padding);
    ivec3 size=hi-lo+1;
    bool longPath=any(greaterThan(abs(motion),vec3(uCellSize*PACKAGE_MAX_SWEEP_CELLS)))
            || any(greaterThan(size,ivec3(32))) || size.x*size.y*size.z>2048;
    if(longPath) {
        uint slot=atomicAdd(longBodyCount,1u);longBodies[slot]=i;return;
    }
    uvec3 positive=floatBitsToUint(max(motion,vec3(0))),negative=floatBitsToUint(max(-motion,vec3(0)));
    for(int z=lo.z;z<=hi.z;z++)for(int y=lo.y;y<=hi.y;y++)for(int x=lo.x;x<=hi.x;x++) {
        uint cell=hashCell(ivec3(x,y,z));
        atomicMax(fastCells[cell].positive.x,positive.x);atomicMax(fastCells[cell].positive.y,positive.y);atomicMax(fastCells[cell].positive.z,positive.z);
        atomicMax(fastCells[cell].negative.x,negative.x);atomicMax(fastCells[cell].negative.y,negative.y);atomicMax(fastCells[cell].negative.z,negative.z);
        atomicOr(fastCells[cell].positive.w,1u);
    }
}

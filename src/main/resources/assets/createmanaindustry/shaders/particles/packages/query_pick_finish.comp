#pragma cmi_include packages/query_state.glsl
layout(std430,binding=4) readonly buffer QueryGroups { uvec4 groups[]; };
layout(std430,binding=5) buffer QueryOutput { QueryResult result[]; };
layout(local_size_x=64) in;
uniform uint uGroups;
uniform uint uPickType;
uniform float uPartial;
uniform vec3 uFrom,uRay;
shared float bestDistance[64];
shared uint bestCandidate[64];
void main() {
    uint lane=gl_LocalInvocationID.x;float distance=2.0;uint candidate=QUERY_NONE;
    for(uint i=lane;i<uGroups;i+=64u) {
        float other=uintBitsToFloat(groups[i].x);uint index=groups[i].y;
        if(other<distance || other==distance && index<candidate){distance=other;candidate=index;}
    }
    bestDistance[lane]=distance;bestCandidate[lane]=candidate;barrier();
    for(uint width=32u;width>0u;width>>=1u) {
        if(lane<width) {
            float other=bestDistance[lane+width];uint index=bestCandidate[lane+width];
            if(other<bestDistance[lane] || other==bestDistance[lane] && index<bestCandidate[lane]) {
                bestDistance[lane]=other;bestCandidate[lane]=index;
            }
        }
        barrier();
    }
    if(lane==0u) {
        QueryResult pose=bestCandidate[0]!=QUERY_NONE?queryPose(bestCandidate[0],false):queryEmpty();
        if(uPickType==0u && bestCandidate[0]!=QUERY_NONE) {
            pose.targetYaw.xyz=uFrom+uRay*bestDistance[0];
            pose.progress.xy=vec2(bestDistance[0],uPartial);
            // Free picking also returns the exact displayed center/yaw for the one retained
            // native entity used by interaction callbacks. No CPU pose interpolation or scan.
            pose.previousTargetYaw=mix(pose.previousPositionYaw,pose.positionYaw,uPartial);
            pose.previousTargetYaw.w=pose.previousPositionYaw.w
                    +(mod(pose.positionYaw.w-pose.previousPositionYaw.w+180.0,360.0)-180.0)*uPartial;
        }
        result[0]=pose;
    }
}

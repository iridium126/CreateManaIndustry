#pragma cmi_include packages/draw_state.glsl
layout(local_size_x=64) in;
#ifdef CMI_SPLIT_DRAW
layout(std430,binding=9) readonly buffer DrawVisibility { uint drawVisible[]; };
#endif
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
#ifdef CMI_SPLIT_DRAW
    if(drawVisible[i]==0u)return;
#endif
    uvec4 result=admitted[2u*i+1u];uint s=result.x;
#ifndef CMI_SPLIT_DRAW
    if(s==0u || s>uCapacity || (result.y&4u)!=0u)return;
#endif
    --s;
#ifndef CMI_SPLIT_DRAW
    if(!visible(s,i,result.y))return;
#endif
    uint box=mesh(s,false),rig=mesh(s,true);
    if(box<uMeshCount)instances[atomicAdd(cursors[drawGroup(box,result.y)],1u)]=uvec2(s,i<<1u);
    if(rig<uMeshCount && (result.y&1u)!=0u)
        instances[atomicAdd(cursors[drawGroup(rig,result.y)],1u)]=uvec2(s,(i<<1u)|1u);
}

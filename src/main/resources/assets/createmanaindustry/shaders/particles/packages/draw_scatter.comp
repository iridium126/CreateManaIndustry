#pragma cmi_include packages/draw_state.glsl
layout(local_size_x=64) in;
layout(std430,binding=9) readonly buffer DrawVisibility { uint drawVisible[]; };
#ifdef CMI_IMPORTED_SCATTER
layout(std430,binding=7) readonly buffer ImportReservation { uint base; uint accepted; uint activeAccepted; uint preparedAccepted; };
layout(std430,binding=8) readonly buffer ImportSelection { uint activeCount; uint preparedCount; uint pad1; uint pad2; uint selected[]; };
#endif
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
#ifdef CMI_IMPORTED_SCATTER
    // Only import-accepted candidates have a visibility word in this generation.
    if(i>=accepted)return;
    i=selected[i<activeAccepted?i:uCount-1u-(i-activeAccepted)];
#endif
    if(drawVisible[i]==0u)return;
    uvec4 result=admitted[2u*i+1u];uint s=result.x;
    --s;
    uint box=mesh(s,false),rig=mesh(s,true);
    if(box<uMeshCount)instances[atomicAdd(cursors[drawGroup(box,result.y)],1u)]=uvec2(s,i<<1u);
    if(rig<uMeshCount && (result.y&1u)!=0u)
        instances[atomicAdd(cursors[drawGroup(rig,result.y)],1u)]=uvec2(s,(i<<1u)|1u);
}

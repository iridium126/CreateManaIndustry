#pragma cmi_include packages/delta_common.glsl
struct Body { vec4 positionMass; vec4 velocityGround; vec4 extentYaw; vec4 previousSleep; };
layout(std430,binding=5) readonly buffer Bodies { Body bodies[]; };
layout(local_size_x=64) in;
uniform uint uBodyCount;
uniform vec3 uOriginOffset;
shared uint prefix[64];
shared uint base;

bool finite4(vec4 value) { return !any(isnan(value)) && !any(isinf(value)); }
void main() {
    uint i=gl_GlobalInvocationID.x,lane=gl_LocalInvocationID.x;
    // Tail threads MUST participate in every barrier, including when uCount == 1.
    bool valid=i<uCount;
    DeltaMeta m; Quantized q; uint mask=0u,status=0u;
    bool dirty=false;
    if(valid) {
        m=meta[i];
        if((m.selection.z&1u)!=0u && flight[i]==0u) {
            if(m.selection.x>=uBodyCount) status=1u;
            else {
                Body b=bodies[m.selection.x];
                vec3 feet=b.positionMass.xyz+uOriginOffset-vec3(0,b.extentYaw.y,0);
                vec3 position=roundEven(feet*4096.0);
                vec3 velocity=floor(b.velocityGround.xyz*1024.0+0.5);
                bool supported=finite4(b.positionMass) && finite4(b.velocityGround)
                    && finite4(b.extentYaw) && finite4(b.previousSleep)
                    && b.positionMass.w>0.0 && b.previousSleep.w>=0.0
                    && all(greaterThan(b.extentYaw.xyz,vec3(0)))
                    && all(greaterThanEqual(feet,vec3(0))) && all(lessThan(feet,vec3(64)))
                    // A rounded point on 64 is outside the server's region too.
                    && all(lessThan(position,vec3(262144)))
                    && all(greaterThanEqual(velocity,vec3(-32768))) && all(lessThanEqual(velocity,vec3(32767)))
                    && dot(dvec3(velocity),dvec3(velocity))<=1073741824.0
                    && abs(b.extentYaw.w)<=1000000.0;
                if(!supported) status=1u;
                else {
                    q.positionFlags=ivec4(ivec3(position),b.velocityGround.w>0.5?1:0);
                    // Java Math.round uses ties toward +infinity. Double keeps yaw's wire
                    // integer identical to PackageDeltaCodec, including negative windings.
                    double yaw=double(b.extentYaw.w);
                    yaw-=trunc(yaw/360.0)*360.0;
                    // Unsuffixed GLSL constants are float: perform this division in double too.
                    precise double scaledYaw=yaw*(double(65536)/double(360));
                    int quantizedYaw=int(floor(scaledYaw+0.5));
                    quantizedYaw=(quantizedYaw&65535);if(quantizedYaw>=32768)quantizedYaw-=65536;
                    q.velocityYaw=ivec4(ivec3(velocity),quantizedYaw);
                    Quantized old=baseline[i];
                    if(any(notEqual(old.positionFlags.xyz,q.positionFlags.xyz)))mask|=1u;
                    if(any(notEqual(old.velocityYaw.xyz,q.velocityYaw.xyz)))mask|=2u;
                    if(old.velocityYaw.w!=q.velocityYaw.w)mask|=4u;
                    if(old.positionFlags.w!=q.positionFlags.w)mask|=8u;
                }
            }
            dirty=status!=0u || mask!=0u;
        }
    }
    prefix[lane]=dirty?1u:0u;barrier();
    for(uint distance=1u;distance<64u;distance<<=1u) {
        uint add=lane>=distance?prefix[lane-distance]:0u;
        barrier();prefix[lane]+=add;barrier();
    }
    // One global reservation per workgroup, independent of the number of changed packages.
    if(lane==0u){base=0u;if(prefix[63]!=0u)base=atomicAdd(requested,prefix[63]);}barrier();
    if(dirty) {
        uint destination=base+prefix[lane]-1u;
        if(destination<uCapacity) {
            if(status!=0u){q.positionFlags=ivec4(0);q.velocityYaw=ivec4(0);}
            records[destination]=DeltaRecord(m.identity,uvec4(i,m.selection.y,mask,status),q);
            // Readback never advances a baseline. Keep this identity pending until exact ACK
            // or cancellation; candidates that overflow remain dirty for a later capture.
            flight[i]=uStamp;
        }
    }
}

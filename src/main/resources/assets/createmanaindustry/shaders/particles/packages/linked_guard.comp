#define CMI_BOUNDED_LINKED
#pragma cmi_include packages/state.glsl
layout(local_size_x=64) in;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
    Body b=src[i];
    if(b.positionMass.w>0.0 && b.previousSleep.w>=0.0) {
        ivec3 cell=cellOf(b.positionMass.xyz);
        if(!gridBudget(cell-1,cell+1))b.previousSleep.w=-1.0;
    }
    dst[i]=b;
}

#pragma cmi_include packages/state.glsl
#pragma cmi_include packages/environment_state.glsl
#ifdef CMI_WORLD
#pragma cmi_include packages/world_collision.glsl
#else
#pragma cmi_include packages/sweep.glsl
uniform float uDt;
#endif
uniform bool uStaticBodies;
layout(local_size_x=64) in;
uniform float uGravity;
uniform float uDrag;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=uCount)return;
    Body b=src[i];
    if(environmentBlocked(i)){freezeForMissingCollision(b,b.positionMass.xyz);dst[i]=b;return;}
    if(b.previousSleep.w<0.0){dst[i]=b;return;}
    b.previousSleep.xyz=b.positionMass.xyz;
    if(b.positionMass.w>0.0) {
        b.velocityGround.y-=uGravity*uDt;
        b.velocityGround.xyz*=uDrag;
        b.velocityGround.w=0.0;
        vec3 motion=b.velocityGround.xyz*uDt;
        for(int slide=0;slide<3;slide++) {
            vec3 p=b.positionMass.xyz;
            ivec3 lo=cellOf(min(p,p+motion)-b.extentYaw.xyz-vec3(uCellSize*.5));
            ivec3 hi=cellOf(max(p,p+motion)+b.extentYaw.xyz+vec3(uCellSize*.5));
            ivec3 size=hi-lo+1;
            bool staticGridFallback=any(greaterThan(size,ivec3(32))) || size.x*size.y*size.z>1024;
            float closest=1.0;vec3 hitNormal=vec3(0);uint visits=0u;
#ifdef CMI_WORLD
            if(!sweepWorld(b,p,motion,closest,hitNormal)) {
                // Unknown/unsupported world coverage is a temporary simulation pause.
                // Keep the last stable pose and retry once the collision atlas is ready.
                b=src[i];freezeForMissingCollision(b,src[i].positionMass.xyz);dst[i]=b;return;
            }
#endif
            if(uStaticBodies) {
            if(!gridBudget(lo,hi))staticGridFallback=true;
            if(!staticGridFallback) {
                for(int z=lo.z;z<=hi.z&&!staticGridFallback;z++)for(int y=lo.y;y<=hi.y&&!staticGridFallback;y++)for(int x=lo.x;x<=hi.x&&!staticGridFallback;x++) {
                    ivec3 cell=ivec3(x,y,z);uint cursor,end;cellCursor(cell,cursor,end);
                    while(cursor!=end) {
                        if(++visits>uCandidateBudget){staticGridFallback=true;break;}
                        uint j=cursorBody(cursor);
                        Body other=src[j];
                        if(other.positionMass.w==0.0 && all(equal(cellOf(other.positionMass.xyz),cell))) {
                            vec3 extent=b.extentYaw.xyz+other.extentYaw.xyz;float t;vec3 n;
                            if(sweepBox(p,motion,other.positionMass.xyz-extent,other.positionMass.xyz+extent,t,n)
                                    && t<=closest) { closest=t;hitNormal=n; }
                        }
                        cursor=cursorNext(cursor,j);
                    }
                }
            }
            if(staticGridFallback) {
                // Long paths and congested buckets retain exact contacts by
                // scanning the compact body array after the cheaper grid path
                // exceeds its work budget.
                closest=1.0;hitNormal=vec3(0);
                for(uint j=0u;j<uCount;j++) {
                    Body other=src[j];if(other.positionMass.w!=0.0)continue;
                    vec3 otherLo=other.positionMass.xyz-other.extentYaw.xyz;
                    vec3 otherHi=other.positionMass.xyz+other.extentYaw.xyz;
                    if(any(greaterThan(lo,otherHi))||any(greaterThan(otherLo,hi)))continue;
                    vec3 extent=b.extentYaw.xyz+other.extentYaw.xyz;float t;vec3 n;
                    if(sweepBox(p,motion,other.positionMass.xyz-extent,other.positionMass.xyz+extent,t,n)
                            &&t<=closest){closest=t;hitNormal=n;}
                }
            }
            }
            b.positionMass.xyz+=motion*closest;
            if(all(equal(hitNormal,vec3(0))))break;
            motion*=1.0-closest;
            motion-=hitNormal*min(0.0,dot(motion,hitNormal));
            b.velocityGround.xyz-=hitNormal*min(0.0,dot(b.velocityGround.xyz,hitNormal));
            if(hitNormal.y>0.0)b.velocityGround.w=1.0;
            if(dot(motion,motion)<1e-12)break;
        }
    }
    dst[i]=b;
}

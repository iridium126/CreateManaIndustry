#pragma cmi_include packages/chain_tracks.glsl
layout(std430,binding=0) readonly buffer Events { ChainEvent events[]; };
layout(std430,binding=1) buffer Flights { uint flight[]; };
layout(std430,binding=2) buffer Header { uint requested,accepted,overflow,reserved; };
layout(std430,binding=3) writeonly buffer Records { ChainEvent records[]; };
layout(local_size_x=64) in;
uniform uint uCount,uCapacity,uStamp;
shared uint prefix[64];shared uint base;
void main() {
    uint i=gl_GlobalInvocationID.x,lane=gl_LocalInvocationID.x;
    bool valid=i<uCount;bool dirty=false;ChainEvent event;
    if(valid){event=events[i];dirty=flight[i]==0u && (any(notEqual(event.masks.xy,uvec2(0))) || event.masks.w!=0u && (event.masks.w&0x80000000u)!=0u);}
    prefix[lane]=dirty?1u:0u;barrier();
    for(uint distance=1u;distance<64u;distance<<=1u) {
        uint add=lane>=distance?prefix[lane-distance]:0u;barrier();prefix[lane]+=add;barrier();
    }
    if(lane==0u){base=0u;if(prefix[63]!=0u)base=atomicAdd(requested,prefix[63]);}barrier();
    if(dirty) {uint destination=base+prefix[lane]-1u;if(destination<uCapacity){records[destination]=event;flight[i]=uStamp;}}
}

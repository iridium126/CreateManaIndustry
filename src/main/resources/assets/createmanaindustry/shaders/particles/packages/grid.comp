layout(local_size_x=64) in;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=uCount)return;
    if(!packageInContactGrid(src[i].previousSleep.w))return;
    uint bucket=hashCell(cellOf(src[i].positionMass.xyz));
    links[i]=atomicExchange(heads[bucket],i);
}

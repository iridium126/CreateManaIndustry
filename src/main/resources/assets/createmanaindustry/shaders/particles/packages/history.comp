#pragma cmi_include packages/state.glsl
struct Chain { vec4 startRadius; vec4 endLength; vec4 progress; vec4 targetYaw; };
layout(std430,binding=4) buffer Chains { Chain chains[]; };
layout(std430,binding=5) buffer History { vec4 history[]; };
layout(local_size_x=64) in;
uniform int uChain;
uniform uint uFirst;
uniform uint uLength;
void main() {
    uint local=gl_GlobalInvocationID.x;
    if(local>=uLength)return;
    uint i=uFirst+local;if(i>=uCount)return;
    // Retirement freezes the complete last pose, including interpolation history. Other
    // active packages may keep stepping while this package's handback query is in flight.
    // Modes 0/2 initialize free/chain ranges; 3/1 capture free/chain simulation history.
    if((uChain==1 || uChain==3) && src[i].previousSleep.w==PACKAGE_RETIRED)return;
    // Tracked modes 2/3 already carry their exact uploaded hook target. startRadius
    // stores previous progress/track index there, not legacy position/radius.
    if(uChain==2 && chains[i].progress.z<2.0) {
        Chain c=chains[i];vec3 target;
        if(c.progress.z>.5) {
            float angle=radians(c.progress.x);
            target=c.startRadius.xyz+vec3(sin(angle),0,cos(angle))*c.startRadius.w;
        } else {
            vec3 d=c.endLength.xyz-c.startRadius.xyz;float len=length(d);
            target=c.startRadius.xyz+(len>0?d/len:vec3(0))*clamp(c.progress.x,0.0,c.endLength.w);
        }
        c.targetYaw=vec4(target-vec3(0,9.0/16.0,0),src[i].extentYaw.w);chains[i]=c;
    }
    history[2u*i]=vec4(src[i].positionMass.xyz,src[i].extentYaw.w);
    history[2u*i+1u]=uChain==1 || uChain==2?chains[i].targetYaw:vec4(src[i].positionMass.xyz,0);
}

#pragma cmi_include packages/observer_state.glsl
layout(local_size_x=64) in;
uniform uvec4 uRetireFence;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uSlots)return;
    ObserverState s=state[i];
    if(s.lifecycle.z==1u && all(equal(s.fence,uRetireFence))) {
        s.lifecycle.z=2u;state[i]=s;
    }
}

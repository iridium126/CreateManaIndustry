#pragma cmi_include packages/state.glsl
// One link record per body: start/radius, end/length, progress/speed/loop/reverse, swing target/yaw.
struct Chain { vec4 startRadius; vec4 endLength; vec4 progress; vec4 targetYaw; };
layout(std430,binding=4) buffer Chains { Chain chains[]; };
layout(local_size_x=64) in;
uniform float uDt;
float angleDelta(float a,float b) { return mod(b-a+180.0,360.0)-180.0; }
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
    Body b=src[i];Chain c=chains[i];
    if(b.previousSleep.w<0.0){dst[i]=b;return;}
    float steps=uDt*20.0;
    b.previousSleep.xyz=b.positionMass.xyz;
    vec3 target;
    float yaw;
    if(c.progress.z>0.5) {
        c.progress.x=mod(c.progress.x+c.progress.y*uDt,360.0);
        float a=radians(c.progress.x);
        target=c.startRadius.xyz+vec3(sin(a),0,cos(a))*c.startRadius.w;
        yaw=c.progress.x+(c.progress.w>0.5?180.0:0.0);
    } else {
        c.progress.x=clamp(c.progress.x+c.progress.y*uDt,0.0,c.endLength.w);
        vec3 d=c.endLength.xyz-c.startRadius.xyz;
        float len=length(d);
        target=c.startRadius.xyz+(len>0.0?d/len:vec3(0))*c.progress.x;
        yaw=dot(d.xz,d.xz)>1e-12 ? degrees(atan(d.x,d.z))-90.0 : b.extentYaw.w;
    }
    vec3 offset=b.positionMass.xyz-target;
    float distance=length(offset);
    if(distance>1.5)b.positionMass.xyz=target+offset*(1.5/distance);
    // Preserve the original 20 Hz recurrence; other rates use exponential damping.
    float damping=pow(0.75,steps);
    b.velocityGround.xyz=(b.velocityGround.xyz+vec3(0,-0.25*steps,0))*damping
            +(target-b.positionMass.xyz)*(1.0-damping);
    b.positionMass.xyz+=b.velocityGround.xyz*steps;
    b.extentYaw.w+=angleDelta(b.extentYaw.w,yaw)*(1.0-damping);
    c.targetYaw=vec4(target-vec3(0,9.0/16.0,0),yaw);
    chains[i]=c;dst[i]=b;
}

layout(local_size_x=64) in;
#pragma cmi_include packages/body_lifecycle.glsl
struct Body { vec4 positionMass; vec4 velocityGround; vec4 extentYaw; vec4 previousSleep; };
struct Meta { uvec4 identity; uvec4 selection; vec4 previousTargetYaw; vec4 style; vec4 nudge; };
layout(std430,binding=0) readonly buffer Bodies { Body bodies[]; };
layout(std430,binding=2) readonly buffer Metadata { Meta meta[]; };
layout(std430,binding=5) buffer Admission { uvec4 admitted[]; };
layout(std430,binding=7) buffer Selection { uint activeCount; uint preparedCount; uint pad1; uint pad2; uint selected[]; };
uniform uint uCount,uBodyCount,uMeshCount;
struct Chain { vec4 startRadius; vec4 endLength; vec4 progress; vec4 targetYaw; };
layout(std430,binding=4) readonly buffer Chains { Chain chains[]; };
uniform uint uFrameCount;
// Raw vec4 rows give the capacity check an explicit 16-byte stride even when
// this pass consumes only the array length rather than any matrix fields.
layout(std430,binding=10) readonly buffer Frames { vec4 frameRows[]; };
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
    Meta m=meta[i];admitted[2u*i]=m.identity;admitted[2u*i+1u]=uvec4(0);
    if(m.selection.x>=uBodyCount || m.selection.y>=uMeshCount)return;
    if((m.selection.w&1u)!=0u && m.selection.z>=uMeshCount)return;
    if((m.selection.w&8u)!=0u) {
        Chain c=chains[m.selection.x];
        if(!(c.progress.z>=2.0) || c.startRadius.w<0.0 || c.startRadius.w>=float(min(uFrameCount,uint(frameRows.length()/6))) || c.startRadius.w!=floor(c.startRadius.w))return;
        uint a=6u*uint(c.startRadius.w);
        for(uint row=0u;row<6u;row++)if(any(isnan(frameRows[a+row])) || any(isinf(frameRows[a+row])))return;
        for(uint pose=0u;pose<2u;pose++) {
            uint row=a+3u*pose;
            mat3 m=transpose(mat3(frameRows[row].xyz,frameRows[row+1u].xyz,frameRows[row+2u].xyz));
            // A missing/singular pose must not reach inverse picking or normal transforms.
            if(dot(m[0],cross(m[1],m[2]))<=0.0)return;
        }
    }
    Body b=bodies[m.selection.x];
    bool prepared=b.previousSleep.w==PACKAGE_PREPARED && (m.selection.w&4u)!=0u;
    bool collisionFrozen=b.previousSleep.w==PACKAGE_COLLISION_FROZEN;
    if((b.previousSleep.w<0.0 && !prepared && !collisionFrozen) || b.positionMass.w<=0.0)return;
    if(any(isnan(b.positionMass.xyz)) || any(isinf(b.positionMass.xyz)))return;
    // The two streams grow from opposite ends; their total cannot exceed uCount.
    if((m.selection.w&4u)!=0u)selected[uCount-1u-atomicAdd(preparedCount,1u)]=i;
    else selected[atomicAdd(activeCount,1u)]=i;
}

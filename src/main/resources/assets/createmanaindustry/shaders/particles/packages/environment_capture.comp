#pragma cmi_include packages/state.glsl
#pragma cmi_include packages/environment_state.glsl
struct PackageEnvironmentEvent { PackageEnvironment header; PackageEnvironmentSample samples[20]; };
layout(std430,binding=6) buffer EnvironmentEvents { uvec4 eventCount; PackageEnvironmentEvent events[]; };
layout(std430,binding=7) buffer EnvironmentCaptureStamps { uint captureStamps[]; };
uniform uint uScanOffset;
uniform uint uEventCapacity;
uniform uint uCaptureSerial;
uniform bool uFreshOnly;
layout(local_size_x=64) in;
void capturePending(uint i,inout uint missingPages){
    PackageEnvironment e=environment[i];
    uint pending=e.lease.z-e.lease.w;
    if(e.control.z==0u||pending==0u){clearEnvironmentPending(i);return;}
    if(pending>20u)return;
    if(uFreshOnly&&e.control.y==0u&&environmentSamples[environmentWorkspace(i)].timeline.y==0u)missingPages++;
    if(captureStamps[i]==uCaptureSerial)return;
    if(uFreshOnly&&floatBitsToUint(e.state.y)==e.lease.z)return;
    uint slot=atomicAdd(eventCount.x,1u);if(slot>=uEventCapacity)return;
    captureStamps[i]=uCaptureSerial;
    // state.zw carry the exact 64-bit lease revision; state.y is local scratch.
    environment[i].state.y=uintBitsToFloat(e.lease.z);
    e.state.y=uintBitsToFloat(i);events[slot].header=e;
    for(uint n=0u;n<pending;n++)events[slot].samples[n]=environmentSamples[environmentRecord(i,e.lease.w+n)];
}
void main(){
    uint words=(uCount+31u)>>5u,invocation=gl_GlobalInvocationID.x;
    if(invocation>=words)return;
    if(invocation==0u){
        // The first pass accumulates in device storage. Publish once after its
        // dispatch barrier; mapped snapshot atomics serialize sparse cohorts.
        if(!uFreshOnly)eventCount.y=uint(atomicExchange(environmentSamples[environmentAllocator()].contact.y,0));
        eventCount.z=uint(environmentSamples[environmentAllocator()].contact.z);
        eventCount.w=uint(environmentSamples[environmentAllocator()].contact.x);
    }
    uint missingPages=0u;
    uint word=(invocation+uScanOffset)%words;
    uint bits=uint(environmentSamples[environmentPendingBase()+(word>>2u)].contact[word&3u]);
    while(bits!=0u){
        uint bit=uint(findLSB(bits));bits&=bits-1u;
        uint body=word*32u+bit;
        if(body<uCount)capturePending(body,missingPages);
    }
    if(uFreshOnly&&missingPages!=0u)atomicAdd(environmentSamples[environmentAllocator()].contact.y,int(missingPages));
}

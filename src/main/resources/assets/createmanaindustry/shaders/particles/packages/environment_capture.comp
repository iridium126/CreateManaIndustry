#pragma cmi_include packages/state.glsl
#pragma cmi_include packages/environment_state.glsl
struct PackageEnvironmentEvent { PackageEnvironment header; PackageEnvironmentSample samples[20]; };
layout(std430,binding=6) buffer EnvironmentEvents { uvec4 eventCount; PackageEnvironmentEvent events[]; };
layout(std430,binding=7) buffer EnvironmentCaptureStamps { uint captureStamps[]; };
uniform uint uScanOffset;
uniform uint uEventCapacity;
uniform uint uCaptureSerial;
uniform bool uFreshOnly;
layout(local_size_x=64) in;
void main(){
    uint invocation=gl_GlobalInvocationID.x;if(invocation>=uCount)return;
    uint i=(invocation+uScanOffset)%uCount;PackageEnvironment e=environment[i];
    uint pending=e.lease.z-e.lease.w;if(e.control.z==0u||pending==0u||pending>20u)return;
    if(captureStamps[i]==uCaptureSerial)return;
    if(uFreshOnly&&floatBitsToUint(e.state.y)==e.lease.z)return;
    uint slot=atomicAdd(eventCount.x,1u);if(slot>=uEventCapacity)return;
    captureStamps[i]=uCaptureSerial;
    // state.zw carry the exact 64-bit lease revision; state.y is local scratch.
    environment[i].state.y=uintBitsToFloat(e.lease.z);
    e.state.y=uintBitsToFloat(i);events[slot].header=e;
    for(uint n=0u;n<pending;n++)events[slot].samples[n]=environmentSamples[i*20u+(e.lease.w+n)%20u];
}

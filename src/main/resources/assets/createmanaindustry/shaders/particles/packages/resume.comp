#define CMI_BODY_INPLACE 1
#pragma cmi_include packages/state.glsl
#pragma cmi_include packages/environment_state.glsl
#pragma cmi_include packages/world_collision.glsl
layout(local_size_x=64) in;
uniform float uGravity,uDrag;
uniform bool uCheckWorld;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;Body b=src[i];
    if(b.previousSleep.w==PACKAGE_COLLISION_FROZEN&&!environmentBlocked(i)) {
        bool ready=true;
        if(uCheckWorld) {
            vec3 velocity=b.velocityGround.xyz;
            velocity.y-=uGravity*uDt;
            velocity*=uDrag;
            vec3 motion=velocity*uDt;
            ready=worldSweepAvailable(b,b.positionMass.xyz,motion);
        }
        if(ready){b.previousSleep.w=0.0;src[i]=b;}
    }
}

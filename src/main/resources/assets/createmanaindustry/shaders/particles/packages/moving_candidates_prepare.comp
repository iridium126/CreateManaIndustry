layout(local_size_x=1) in;
layout(std430,binding=3) buffer Links {uint links[];};
uniform uint uActiveCount,uCandidateOffset;
void main(){
    uint header=3u*uCandidateOffset/2u,count=links[header+4u];links[header+6u]=count;
    // Dense scenes retain contiguous/active order instead of a randomized gather.
    if(count>uActiveCount/2u){links[header+5u]=1u;count=uActiveCount;links[header+4u]=count;}
    links[header]=(count+63u)/64u;links[header+1u]=1u;links[header+2u]=1u;links[header+3u]=0u;
}

#define CMI_BODY_INPLACE
#pragma cmi_include packages/state.glsl
#pragma cmi_include packages/world_collision.glsl
#pragma cmi_include packages/environment_state.glsl
layout(local_size_x=64) in;
uniform uvec2 uSimulationStep;
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=uCount)return;
    Body b=src[i];PackageEnvironment e=environment[i];
    if(e.control.z==0u||b.positionMass.w<=0.0||b.previousSleep.w<0.0||environmentBlocked(i))return;
    vec3 p=b.previousSleep.xyz,motion=b.positionMass.xyz-p;
    ivec3 first,last;uint flags=0u;ivec3 contact=ivec3(0);vec3 contactPosition=b.positionMass.xyz;
    vec3 queryLo=min(p,p+motion)-b.extentYaw.xyz-.002,queryHi=max(p,p+motion)+b.extentYaw.xyz+.002;
    if(!worldBounds(queryLo,queryHi,first,last))return;
    if(!clearWorld(first,last)){
        ivec3 cached=ivec3(0);int slot=-2;
        for(int z=first.z;z<=last.z;z++)for(int y=first.y;y<=last.y;y++)for(int x=first.x;x<=last.x;x++){
            ivec3 block=ivec3(x,y,z);uvec4 cell;uint base;
            if(!worldCell(block,queryLo,queryHi,cached,slot,cell,base))continue;
            uint kind=(cell.w&7u)|((cell.w&48u)>>1);if(kind==0u)continue;
            float height=(kind&3u)!=0u&&(cell.w>>8u)!=0u?float((cell.w>>8u)&255u)/255.0:1.0;
            vec3 lo=vec3(block)-b.extentYaw.xyz,hi=vec3(block)+vec3(1,height,1)+b.extentYaw.xyz;
            if((kind&24u)!=0u){lo-=.002;hi+=.002;}
            float time=0.0;vec3 normal;
            bool inside=all(greaterThan(p,lo))&&all(lessThan(p,hi));
            if(!inside&&!sweepBox(p,motion,lo,hi,time,normal))continue;
            // Water destruction takes precedence; lava and fire use Create's fire damage rule.
            uint selected=(kind&1u)!=0u?1u:(kind&2u)!=0u?2u:(kind&4u)!=0u?4u:(kind&8u)!=0u?8u:16u;
            if(flags==0u||selected<flags){flags=selected;contact=block;contactPosition=inside?p:p+motion*time;}
        }
    }
    uint oldFire=e.control.x;float health=e.state.x;
    bool fireAllowed=(e.control.w&4u)!=0u;
    if(oldFire>0u){if(fireAllowed&&oldFire%20u==0u)health-=.15;e.control.x--;}
    if((flags&e.control.w&6u)!=0u){
        if(e.control.x==0u)e.control.x=100u;else health-=.15;
        if(flags==2u)e.control.x=max(e.control.x,300u);
    }
    if(flags==0u&&oldFire==0u)return;
    uint written=e.lease.z;
    environmentSamples[i*PACKAGE_ENV_HISTORY+written%PACKAGE_ENV_HISTORY]=PackageEnvironmentSample(
        ivec4(contact,int(flags)),uvec4(uSimulationStep,e.control.x,floatBitsToUint(max(health,0.0))),vec4(contactPosition,0));
    e.lease.z++;e.state.x=max(health,0.0);
    if((flags&e.control.w&1u)!=0u||health<=.5){e.control.y=1u;b.previousSleep.w=PACKAGE_COLLISION_FROZEN;src[i]=b;}
    environment[i]=e;
}

// Display-only projection. No buffer in this interface is a gameplay output.
layout(local_size_x=256) in;
#pragma cmi_include chunks/feather_state.glsl
// The display pass shares the stable, read-only attack-data texture with model draws.
#define CMI_STARFALL_TBO
#pragma cmi_include chunks/allay_storm.glsl
#pragma cmi_include chunks/storm_trajectory.glsl
#pragma cmi_include chunks/column_display.glsl
#pragma cmi_include chunks/ordinary_roster.glsl
layout(std430,binding=0) readonly buffer CurrentPool {vec4 rows[];} currentPool;
layout(std430,binding=1) readonly buffer PreviousPool {vec4 rows[];} previousPool;
layout(std430,binding=2) buffer DisplayPool {vec4 rows[];} displayPool;
layout(std430,binding=3) readonly buffer CurrentCount {uint live;} currentCount;
layout(std430,binding=4) readonly buffer PreviousCount {uint live;} previousCount;
layout(std430,binding=5) readonly buffer HistoryEdges {uint previousSlot[];} history;
layout(std430,binding=6) buffer DisplayCount {uint live,spare,census,items;} displayCount;
layout(std430,binding=7) buffer Commands {uint cmd[INDIRECT_UINTS];} commands;
#ifdef CMI_DISPLAY_PARAMETERS_UBO
layout(std430,binding=8) buffer Dispatch {uint args[12];} dispatchOut;
#else
layout(std430,binding=8) buffer Dispatch {uint args[9];} dispatchOut;
#endif
layout(std430,binding=9) buffer SortMeta {uvec2 rows[];} sortMeta;
layout(std430,binding=10) readonly buffer Population {uint modelCount;} population;
layout(std430,binding=11) readonly buffer Emitters {vec4 rows[];} emitters;
uniform uint phase;
uniform bool uNativeStormDisplayState;
bool cmiNativeRegionalActive(float identity,uint assignment){
 if(!uNativeStormDisplayState)return true;
 uint at=cmiStarMember(identity)*2u;
 if(at+1u>=uint(currentStormDisplay.words.length()))return false;
 uint state=CMI_STATE(currentStormDisplay,at+1u);
 return state>0u&&state<6u&&CMI_STATE(currentStormDisplay,at)==uint(cmiStarVec(cmiStarBase(cmiStarSlot(assignment))).x+.5);
}
#ifdef CMI_DISPLAY_PARAMETERS_UBO
layout(std140,binding=CMI_DISPLAY_PARAMETERS_BINDING) uniform CmiDisplayParameters {
 uvec4 cmiDisplayLayout;
 vec4 cmiDisplayClock;
 vec4 cmiCurrentCameraDelta;
 vec4 cmiPreviousCameraDelta;
};
#define capacity cmiDisplayLayout.x
#define historyBase cmiDisplayLayout.y
#define metaSlot cmiDisplayLayout.z
#define carrierLimit cmiDisplayLayout.w
#define alpha cmiDisplayClock.x
#define currentCameraDelta cmiCurrentCameraDelta.xyz
#define previousCameraDelta cmiPreviousCameraDelta.xyz
#else
uniform uint capacity,historyBase,metaSlot,carrierLimit;
uniform float alpha;
uniform vec3 currentCameraDelta,previousCameraDelta;
#endif
void main(){
 uint i=gl_GlobalInvocationID.x;
 if(phase==3u){
  if(i<32u)CMI_FEATHER_WORD(i)=0;
  if(i!=0u)return;displayCount.live=min(currentCount.live,capacity);displayCount.spare=0u;displayCount.census=0u;displayCount.items=0u;
  commands.cmd[IDX_CNT_ADD]=0u;commands.cmd[IDX_CNT_SPRITE]=0u;commands.cmd[IDX_CNT_MODELOP]=0u;commands.cmd[IDX_CNT_CARRIER]=0u;commands.cmd[IDX_CNT_GHOST]=0u;commands.cmd[IDX_CNT_ALPHA]=0u;
  dispatchOut.args[0]=(cmiOrdinaryCount(displayCount.live)+63u)/64u;dispatchOut.args[1]=1u;dispatchOut.args[2]=1u;
  dispatchOut.args[3]=(min(population.modelCount,capacity)+63u)/64u;dispatchOut.args[4]=1u;dispatchOut.args[5]=1u;
#ifdef CMI_DISPLAY_PARAMETERS_UBO
  dispatchOut.args[9]=(displayCount.live+255u)/256u;dispatchOut.args[10]=1u;dispatchOut.args[11]=1u;
#endif
  return;
 }
 if(phase==4u){
  if(i!=0u)return;uint n=commands.cmd[IDX_CNT_GHOST]+commands.cmd[IDX_CNT_ALPHA];uint group=n>=SORT_GROUP_THRESHOLD?1024u:64u;
  CMI_FEATHER_WORD(11)=6;CMI_FEATHER_WORD(12)=CMI_FEATHER_WORD(3);CMI_FEATHER_WORD(13)=0;CMI_FEATHER_WORD(14)=0;
  dispatchOut.args[6]=(n+group-1u)/group;dispatchOut.args[7]=1u;dispatchOut.args[8]=1u;
  commands.cmd[IDX_CNT_CARRIER]=min(commands.cmd[IDX_CNT_CARRIER],carrierLimit);
  sortMeta.rows[metaSlot]=uvec2(commands.cmd[IDX_CNT_MODELOP],0);return;
 }
 if(i>=min(currentCount.live,capacity))return;
 uint base=i*4u;vec4 p0=currentPool.rows[base],p1=currentPool.rows[base+1u],p2=currentPool.rows[base+2u],p3=currentPool.rows[base+3u];
 uint hb=floatBitsToUint(p3.w)*VEC4_PER_EMITTER,type=uint(emitters.rows[hb].x);
 uint fields=cmiDisplayFields(type);
 bool relative=(fields&CMI_DISPLAY_CAMERA_RELATIVE)!=0u,model=(fields&CMI_DISPLAY_MODEL)!=0u;
 if(relative)p0.xyz+=currentCameraDelta;
 uint prior=alpha<1.&&fields!=0u?history.previousSlot[historyBase+i]:0u;
 if(prior>0u&&prior<=min(previousCount.live,capacity)){
  uint b=(prior-1u)*4u;
  vec4 q0=previousPool.rows[b];
  // Producers own birth, death and teleport semantics. Render values are never keys.
  if(relative)q0.xyz+=previousCameraDelta;
  if((fields&CMI_DISPLAY_POSITION)!=0u)p0.xyz=mix(q0.xyz,p0.xyz,alpha);
  if((fields&(CMI_DISPLAY_VELOCITY|CMI_DISPLAY_ROTATION))!=0u){
   vec4 q1=previousPool.rows[b+1u];
   if((fields&CMI_DISPLAY_VELOCITY)!=0u)p1.xyz=mix(q1.xyz,p1.xyz,alpha);
   // The feather record tags the resting pose with a negative extent. Its
   // flight roll has a different basis, while position uses the same edge.
   bool rollBasisChanged=(fields&CMI_DISPLAY_FEATHER)!=0u&&(p0.w<0.)!=(q0.w<0.);
   if((fields&CMI_DISPLAY_ROTATION)!=0u&&!rollBasisChanged)p1.w=q1.w+atan(sin(p1.w-q1.w),cos(p1.w-q1.w))*alpha;
  }
  if(model||(fields&(CMI_DISPLAY_COLOR|CMI_DISPLAY_OPACITY))!=0u){
   vec4 q2=previousPool.rows[b+2u];
   if((fields&CMI_DISPLAY_COLOR)!=0u)p2.rgb=mix(q2.rgb,p2.rgb,alpha);
   if(model||(fields&CMI_DISPLAY_OPACITY)!=0u)p2.w=mix(q2.w,p2.w,alpha);
  }
  if((fields&(CMI_DISPLAY_CLOCK|CMI_DISPLAY_BRIGHTNESS))!=0u){
   vec4 q3=previousPool.rows[b+3u];
   if((fields&CMI_DISPLAY_CLOCK)!=0u)p3.x=mix(q3.x,p3.x,alpha);
   if((fields&CMI_DISPLAY_BRIGHTNESS)!=0u)p3.z=mix(q3.z,p3.z,alpha);
   if(model&&p3.y<=0.&&q3.y<=0.&&(fields&CMI_DISPLAY_CLOCK)!=0u)p3.y=mix(q3.y,p3.y,alpha);
  }
  if((fields&CMI_DISPLAY_SIZE)!=0u)p0.w=mix(q0.w,p0.w,alpha);
  if(uStarfallEnabled&&model&&p3.y>0.&&emitters.rows[hb+18u].x>.5){
   uint a=cmiStarAssignment(p0.w);
   if(cmiColumnAssignment(a)){if(cmiNativeRegionalActive(p0.w,a))p0.xyz+=cmiColumnDisplayResidual(a,alpha);}
   else if(a!=0u&&cmiStarClaim(p0.w,uTimeSec)>=0&&cmiStarPhase(a,uTimeSec)<6.&&cmiNativeRegionalActive(p0.w,a)){
    vec3 displayPoint,beforePoint,afterPoint,tangent;uint b=cmiStarBase(cmiStarSlot(a));
    if(cmiDome(b)){
     cmiDomeSampleOffset(a,0.,displayPoint,tangent);
     cmiDomeSampleOffset(a,-alpha*.05,beforePoint,tangent);
     cmiDomeSampleOffset(a,(1.-alpha)*.05,afterPoint,tangent);
    }else{
     displayPoint=cmiStarPoint(a,p3.z,uTimeSec,p0.xyz);
     beforePoint=cmiStarPoint(a,p3.z,uTimeSec-alpha*.05,q0.xyz);
     afterPoint=cmiStarPoint(a,p3.z,uTimeSec+(1.-alpha)*.05,currentPool.rows[base].xyz);
    }
    // Evaluate curvature at the display clock while retaining simulation's
    // collision/steering residual. Speed and phase tags never disable history.
    p0.xyz+=displayPoint-mix(beforePoint,afterPoint,alpha);
   }
  }
 }
 displayPool.rows[base]=p0;displayPool.rows[base+1u]=p1;displayPool.rows[base+2u]=p2;displayPool.rows[base+3u]=p3;
}

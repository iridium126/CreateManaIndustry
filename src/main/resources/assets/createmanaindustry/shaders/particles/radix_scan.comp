// Parallel exclusive prefix sum for MODEL, ALPHA and HEX_PATTERN depth bins.
layout(local_size_x = RADIX_BINS) in;
layout(std430, binding = BIND_HIST) readonly buffer HistBuf { uint h[RADIX_BINS]; } hist;
layout(std430, binding = BIND_OFFSETS) writeonly buffer OffsBuf { uint o[RADIX_BINS]; uint uniformBucket; } offs;
layout(std430, binding = BIND_INDIRECT) readonly buffer Commands { uint cmd[INDIRECT_UINTS]; } indirect;
shared uint s[RADIX_BINS];
shared uint singleBucket;
void main() {
    uint i = gl_LocalInvocationID.x;
    uint original = hist.h[i];
    uint count = indirect.cmd[IDX_CNT_GHOST] + indirect.cmd[IDX_CNT_ALPHA] + indirect.cmd[IDX_CNT_PATTERN];
    if (i == 0u) { singleBucket = 0u; offs.uniformBucket = 0u; }
    s[i] = original;
    barrier();
    if (count >= SORT_GROUP_THRESHOLD) {
        if (original == count) atomicOr(singleBucket, 1u);
        barrier();
        if (singleBucket != 0u) {
            offs.o[i] = 0u;
            if (i == 0u) offs.uniformBucket = 1u;
            return; // identical branch for every invocation
        }
    }
    for (uint stride = 1u; stride < RADIX_BINS; stride <<= 1u) {
        uint addend = i >= stride ? s[i-stride] : 0u;
        barrier();
        s[i] += addend;
        barrier();
    }
    offs.o[i] = s[i] - original;
}

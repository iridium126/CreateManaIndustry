layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Inputs {vec4 data[];} inputs;
layout(std430,binding=1) buffer Jobs {vec4 data[];} jobs;
uniform uint uCount;
uniform float uFadeDistance;
uniform vec4 uFrustum[6];
// Eighteen analytic patches per domain: twelve edges first, then six translucent membranes.
void main(){
    uint idx=gl_GlobalInvocationID.x;if(idx>=uCount*18u)return;
    uint domain=idx/18u,part=idx%18u,base=idx*4u;
    vec3 low=inputs.data[domain*4u].xyz,high=inputs.data[domain*4u+1u].xyz;
    vec3 anchor=inputs.data[domain*4u+3u].xyz;
    vec3 a=low,du=vec3(0),dv=vec3(0);float desired=0;
    if(part<12u){
        uint axis=part/4u,j=(axis+1u)%3u,k=(axis+2u)%3u,side=part%4u;
        a[j]=(side&1u)==0u?low[j]:high[j];a[k]=(side&2u)==0u?low[k]:high[k];
        a[axis]=max(low[axis],anchor[axis]-uFadeDistance);du[axis]=max(0.0,min(high[axis],anchor[axis]+uFadeDistance)-a[axis]);
        desired=ceil(length(du)*64.0);
    }else{
        uint axis=(part-12u)/2u,j=(axis+1u)%3u,k=(axis+2u)%3u;
        a[axis]=((part-12u)&1u)==0u?low[axis]:high[axis];
        a[j]=max(low[j],anchor[j]-uFadeDistance);a[k]=max(low[k],anchor[k]-uFadeDistance);
        du[j]=max(0.0,min(high[j],anchor[j]+uFadeDistance)-a[j]);dv[k]=max(0.0,min(high[k],anchor[k]+uFadeDistance)-a[k]);
        desired=ceil(length(du)*length(dv)*64.0);
    }
    vec3 center=a+(du+dv)*.5,extent=(abs(du)+abs(dv))*.5+vec3(.15);
    for(int p=0;p<6;p++)if(dot(uFrustum[p].xyz,center)+uFrustum[p].w+dot(abs(uFrustum[p].xyz),extent)<0.0)desired=0.0;
    if(length(max(abs(center)-extent,vec3(0)))>uFadeDistance+1.0)desired=0.0;
    float distanceToPatch=length(max(abs(center)-extent,vec3(0)));
    desired*=clamp(24.0/max(24.0,distanceToPatch),.06,1.0);
    if(inputs.data[domain*4u+2u].y>=.8)desired=0.0;
    jobs.data[base]=vec4(a,uintBitsToFloat(uint(min(65536.0,desired))));
    jobs.data[base+1u]=vec4(du,0);jobs.data[base+2u]=vec4(dv,0);jobs.data[base+3u]=vec4(0);
}

layout(local_size_x=1) in;
layout(std430,binding=2) readonly buffer Counter {uint alive;};
layout(std430,binding=4) buffer Commands {uint cmd[];};
uniform uint uCapacity;
void main(){
    for(uint i=0u;i<INDIRECT_UINTS;i++)cmd[i]=0u;
    cmd[INDIRECT_UINTS]=(min(alive,uCapacity)+63u)/64u;cmd[INDIRECT_UINTS+1]=1u;cmd[INDIRECT_UINTS+2]=1u;
}

layout(local_size_x=1) in;
#pragma cmi_include chunks/population_read.glsl
#pragma cmi_include chunks/model_shadow_groups_read.glsl
#pragma cmi_include chunks/shadow_visibility.glsl
layout(std430,binding=3)buffer Instances {uvec2 items[];};
uniform uint uMetaSlot;
uniform vec3 uCamera;
layout(std430,binding=2) readonly buffer Counter {uint alive;};
layout(std430,binding=4) buffer Commands {uint cmd[];};
uniform uint uCapacity;
void main(){
    for(uint i=0u;i<INDIRECT_UINTS;i++)cmd[i]=0u;
    uint count=cmiPopulationCount(min(alive,uCapacity),false),mode=0u;
    if(cmiShadowGroupsValid(count)){
        mode=1u;
        vec3 center=shadowGroupsRead.cylinder.xyz-uCamera;
        center.y+=(shadowGroupsRead.heights.x+shadowGroupsRead.heights.y)*.5;
        if(uShadowViewEnabled&&!cmiShadowCylinderInView(center,shadowGroupsRead.cylinder.w,(shadowGroupsRead.heights.y-shadowGroupsRead.heights.x)*.5)){
            mode=2u;count=shadowGroupsRead.counts.y;
        }
    }
    items[uMetaSlot]=uvec2(0u,mode);
    cmd[INDIRECT_UINTS]=(count+63u)/64u;cmd[INDIRECT_UINTS+1]=1u;cmd[INDIRECT_UINTS+2]=1u;
}

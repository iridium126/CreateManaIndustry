layout(local_size_x=64) in;
#pragma cmi_include chunks/feather_state.glsl
#pragma cmi_include chunks/feather_record.glsl
#pragma cmi_include chunks/feather_leaf_surface.glsl
#pragma cmi_include chunks/storm_collision.glsl
layout(std430,binding=1) buffer Pool {vec4 data[];} pool;
layout(std430,binding=18) readonly buffer Players {vec4 data[];} players;
layout(std430,binding=0) readonly buffer NativeImpacts {vec4 rows[];} nativeImpacts;
layout(std430,binding=2) readonly buffer FeatherSupport {ivec4 rows[];} featherSupport;
uniform uint uPhase,uPlayerCount,uMovementBase,uImpactCount;
uniform bool uFeatherSupport;
uint cmiSupportTag(ivec3 block){
    if(!uFeatherSupport)return 0u;
    uint hash=cmiFeatherCellHash(block);
    for(uint i=0u;i<8u;i++){
        ivec4 row=featherSupport.rows[(hash+i)&8191u];
        if(row.w==0)break;
        if(all(equal(row.xyz,block)))return row.w>=8?1u<<18:0u;
    }
    cmiFeatherRequestKey(block,2);
    return 0u;
}
void main(){
    uint rank=gl_GlobalInvocationID.x;
    if(uPhase==0u){
        if(rank==0u){CMI_FEATHER_WORD(8)=(CMI_FEATHER_WORD(2)+63)/64;CMI_FEATHER_WORD(9)=1;CMI_FEATHER_WORD(10)=1;
            CMI_FEATHER_WORD(11)=6;CMI_FEATHER_WORD(12)=CMI_FEATHER_WORD(3);CMI_FEATHER_WORD(13)=0;CMI_FEATHER_WORD(14)=0;}return;
    }
    if(uPhase==1u){
        if(rank>=uPlayerCount)return;vec4 movement=players.data[uMovementBase+rank];if(movement.w<=0.)return;
        cmiFeatherDisturb(movement.xyz,movement.w);return;
    }
    if(uPhase==3u){
        if(rank<uImpactCount){vec4 impact=nativeImpacts.rows[rank];cmiFeatherDisturb(impact.xyz,impact.w);}
        return;
    }
    if(rank>=uint(CMI_FEATHER_WORD(2)))return;uint slot=uint(CMI_FEATHER_WORD(CMI_FEATHER_GROUND+rank)),b=slot*4u;
    vec4 p0=pool.data[b],p1=pool.data[b+1u],p2=pool.data[b+2u],p3=pool.data[b+3u];if(p0.w>=0.)return;
    const uint leafAttachment=1u<<18;
    uint tag=floatBitsToUint(p3.z)&0x7ffffu;
    if((tag&32768u)!=0u){p0.y+=.002+.004*cmiFeatherHash(p2.x*91.31+p2.y*47.17+float(tag&15u));tag&=~32768u;}
    ivec3 support=cmiFeatherSupportBlock(p0.xyz),section=support>>4;
    cmiFeatherRequestKey(section,1);
    int page=cmiStormPage(section);
    bool known=page!=-1,supported=page==-3||(page>=0&&cmiStormSolidInPage(support,page));
    vec3 lift=supported&&p3.x*20.>=float((tag>>4u)&2047u)?cmiFeatherLift(p0.xyz):vec3(0);
    if(known&&(!supported||lift.y>0.)){
        p0.w=abs(p0.w);p1.xyz=lift;p1.w-=(p2.z+p2.w*(p3.x+.05))*p3.x;
        tag=(tag&0x3000fu)|(uint(ceil((p3.x+.5)*20.))<<4u);
    }else if(supported)tag=(tag&~leafAttachment)|cmiSupportTag(support);
    // Unknown collision coverage keeps the settled pose and attachment. The draw
    // still checks the current terrain mesh before applying leaf deformation.
    pool.data[b]=p0;pool.data[b+1u]=p1;pool.data[b+3u].z=uintBitsToFloat(tag);
}

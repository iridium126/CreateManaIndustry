uniform uint uCarrierLimit;
// Publication boundary: allocation cursors become bounded live counts here.
layout(local_size_x = 1) in;
layout(std430, binding = BIND_PREV_COUNTER) readonly buffer Previous { uint live; } previous;
layout(std430, binding = BIND_COUNTER) buffer Current { uint requested; uint spare; uint census; uint items; } current;
layout(std430, binding = BIND_INDIRECT) buffer Draw { uint cmd[INDIRECT_UINTS]; } draw;
layout(std430, binding = BIND_DISPATCH) writeonly buffer Dispatch { uint args[]; } dispatchOut;
#pragma cmi_include chunks/population_read.glsl
#pragma cmi_include chunks/ordinary_roster.glsl
// Keep the first 16 bytes in PopulationRead order: MODEL, Storm, live, valid.
// Publish all four words with one store before any consumer reads the roster.
layout(std430, binding = BIND_POPULATION_WRITE) buffer PopulationWrite {
    uvec4 counts;
    uvec2 generation;
    uint modelCapacity,stormCapacity;
    uint slots[];
} populationWrite;
uniform bool uPopulationWriteEnabled,uPopulationStormPairs;
uniform uint uCapacity;
uniform uint uPhase;
uniform uint uPackageStaged;
uniform bool uModelMembersEnabled,uModelMembersPublish;
void main() {
    if(uPhase==4u){
        uvec2 counts=populationWrite.counts.xy;
        if(uPackageStaged!=0u&&current.spare<populationWrite.counts.z){
            counts=uvec2(current.census,current.items);
            current.census=0u;current.items=0u;
        }
        populationWrite.counts=uvec4(counts,min(current.requested,uCapacity),uPopulationStormPairs?3u:1u);
        if(dispatchOut.args.length()>=15){dispatchOut.args[12]=max(1u,(counts.y+63u)/64u);dispatchOut.args[13]=1u;dispatchOut.args[14]=1u;}
        if(dispatchOut.args.length()>=18){dispatchOut.args[15]=(counts.x+63u)/64u;dispatchOut.args[16]=1u;dispatchOut.args[17]=1u;}
        return;
    }
    if(uPhase==1u&&uModelMembersEnabled&&uModelMembersPublish){
        populationWrite.counts=uvec4(current.census,current.items,min(current.requested,uCapacity),uPopulationStormPairs?3u:1u);
        current.census=0u;current.items=0u;
    }
    if(uPhase==0u&&dispatchOut.args.length()>=24){dispatchOut.args[21]=(cmiOrdinaryCount(min(previous.live,uCapacity))+63u)/64u;dispatchOut.args[22]=1u;dispatchOut.args[23]=1u;}
    uint n;
    if (uPhase == 0u) n = min(previous.live, uCapacity);
    else if (uPhase == 1u) {
        current.requested = min(current.requested, uCapacity);
        n = uPackageStaged!=0u ? min(current.spare,current.requested) : current.requested;
    } else {
        n = min(current.items, uCapacity);
        draw.cmd[IDX_CNT_CARRIER] = min(draw.cmd[IDX_CNT_CARRIER], (uCarrierLimit==0u?uint(CARRIER_CAP):uCarrierLimit));
        if(uPopulationWriteEnabled){populationWrite.counts=uvec4(populationWrite.counts.xy,min(current.requested,uCapacity),uPopulationStormPairs?3u:1u);memoryBarrierBuffer();}
    }
    if(uPhase==1u&&dispatchOut.args.length()>=18){
        dispatchOut.args[15]=(populationWrite.counts.x+63u)/64u;dispatchOut.args[16]=1u;dispatchOut.args[17]=1u;
    }
    // Feedback uses the candidate Storm roster, which includes births.
    if(uPhase==1u&&dispatchOut.args.length()>=15){
        dispatchOut.args[12]=max(1u,(populationWrite.counts.y+63u)/64u);dispatchOut.args[13]=1u;dispatchOut.args[14]=1u;
    }
    if(uPhase==1u&&dispatchOut.args.length()>=21){
        dispatchOut.args[18]=uPackageStaged!=0u&&current.spare<populationWrite.counts.z?(populationWrite.counts.x+63u)/64u:0u;
        dispatchOut.args[19]=1u;dispatchOut.args[20]=1u;
    }
    uint base = uPhase * 3u;
    uint blockSize = uPhase == 2u && n >= SORT_GROUP_THRESHOLD ? 1024u : 64u;
    dispatchOut.args[base] = (n + blockSize - 1u) / blockSize;
    dispatchOut.args[base + 1u] = 1u;
    dispatchOut.args[base + 2u] = 1u;
    if(dispatchOut.args.length()>=15&&(uPhase==0u||uPhase==2u)){
        uint liveCount=uPhase==0u?min(previous.live,uCapacity):min(current.requested,uCapacity);
        dispatchOut.args[9]=(cmiPopulationCount(liveCount,false)+63u)/64u;dispatchOut.args[10]=1u;dispatchOut.args[11]=1u;
        dispatchOut.args[12]=(cmiPopulationCount(liveCount,true)+63u)/64u;dispatchOut.args[13]=1u;dispatchOut.args[14]=1u;
    }
}

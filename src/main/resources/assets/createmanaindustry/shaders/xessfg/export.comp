#version 450 core

layout(local_size_x = 16, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D sourceTexture;
layout(std430, binding = 0) buffer FrameTransport {
    uint words[];
};
layout(std430, binding = 1) readonly buffer HudlessTransport {
    uint hudlessWords[];
};

uniform ivec2 extent;
uniform ivec2 sourceSize;
uniform ivec4 offsets;
uniform int rowWords;
uniform int mode;
uniform int transport;
uniform mat4 currentToPrevious;
uniform mat4 skyToPrevious;
uniform vec2 sourceScale;
uniform vec2 currentJitter;
uniform ivec2 warpTypes;
uniform vec4 warpParameters;

const int DEPTH = 2;
const int DEPTH_ONLY = 4;
const int FINAL_WITH_MASK = 5;
const int APPLY_MOTION = 6;
const int INITIALIZE_MOTION = 7;
const int APPLY_GPU_MOTION = 8;
const int INITIALIZE_GPU_MOTION = 9;
const int SILDUR_RAIN = 5;
shared vec4 rainDrops[8];
shared uint hudChanges[128];

float surfaceDepth(uint rank) {
    return float(0xffffffu - (rank >> 8)) / 16777215.0;
}

vec4 gpuMotionSample(ivec2 samplePixel) {
    uint pixel = uint(samplePixel.y * extent.x + samplePixel.x);
    uint opaqueAddress = pixel * 2u;
    uint transparentAddress = (pixel + uint(extent.x * extent.y)) * 2u;
    uint opaqueRank = hudlessWords[opaqueAddress + 1u];
    uint transparentRank = hudlessWords[transparentAddress + 1u];
    if ((opaqueRank | transparentRank) == 0u) return vec4(0.0);
    vec2 size = vec2(sourceSize) * sourceScale;
    ivec2 sourcePixel = clamp(ivec2((vec2(samplePixel) + 0.5) * size / vec2(extent) + currentJitter),
                             ivec2(0), max(ivec2(size) - 1, ivec2(0)));
    float depth = texelFetch(sourceTexture, sourcePixel, 0).r;
    // A blended contribution can own the vector while retaining scene depth.
    if (transparentRank != 0u && surfaceDepth(transparentRank) <= depth + 0.000002)
        return vec4(unpackHalf2x16(hudlessWords[transparentAddress]), depth, 1.0);
    if (opaqueRank != 0u && abs(surfaceDepth(opaqueRank) - depth) <= 0.000002)
        return vec4(unpackHalf2x16(hudlessWords[opaqueAddress]), depth, 1.0);
    return vec4(0.0);
}

void buildRainDrops(int first, float time) {
    const vec2 patterns[4] = vec2[4](vec2(-0.94386347, 1.0), vec2(0.9347, -0.2533282),
                                     vec2(0.785282, -0.285282), vec2(-0.347, 0.6847));
    const float radii[4] = float[4](0.1, 0.07, 0.086, 0.092);
    float phase = time * 0.25;
    for (int i = 0; i < 4; i++) {
        float offset = float((i + 1) % 4) * 0.25;
        float noise = fract(sin(dot(patterns[i] * floor(phase + offset), vec2(83147.6995379, 125370.887575))));
        vec2 position = fract(vec2(noise * 0.8 + 0.1) - vec2(0.0, fract(time / 20.0)));
        rainDrops[first + i] = vec4(position, (1.0 - fract(phase + offset)), 1.0 / (radii[i] * radii[i]));
    }
}

vec2 sceneCoordinate(vec2 uv, int effect, vec2 parameters, int firstDrop) {
    float time = parameters.x;
    float strength = parameters.y;
    if (effect == 1) {
        vec2 mapped = uv + strength * vec2(cos(uv.y * 32.0 + time * 3.0), sin(uv.x * 32.0 + time * 1.7));
        return all(greaterThan(mapped, vec2(0.0))) && all(lessThan(mapped, vec2(1.0))) ? mapped : uv;
    }
    if (effect == 2) {
        return uv + strength * sin((uv.x + uv.y) * 25.0 + time * 3.0);
    }
    if (effect == 3 || effect == SILDUR_RAIN) {
        if (effect == SILDUR_RAIN) {
            vec2 aspect = vec2(float(extent.x) / float(extent.y), 1.0);
            for (int i = 0; i < 4; i++) {
                vec4 drop = rainDrops[firstDrop + i];
                vec2 distance = (uv - drop.xy) * aspect;
                strength += 0.01 * drop.z * exp(-dot(distance, distance) * drop.w);
            }
        }
        vec2 mapped = uv + strength * vec2(sin(time + uv.x * 100.0 + uv.y * 50.0),
                                          cos(time + uv.y * 100.0 + uv.x * 50.0));
        vec2 pixel = 1.0 / vec2(extent);
        return clamp(mapped, pixel, 1.0 - pixel);
    }
    if (effect == 4) {
        vec2 offset = uv - 0.5;
        float scale = 1.0 / max(1.0 + strength * 0.25, 1.0 + strength * 0.5);
        return 0.5 + offset * (1.0 + strength * dot(offset, offset)) * scale;
    }
    return uv;
}

vec2 displayCoordinate(vec2 scene, vec2 estimate, int effect, vec2 parameters, int firstDrop) {
    if (effect == 0) return scene;
    if (effect == 4) {
        vec2 offset = scene - 0.5;
        float strength = parameters.y;
        float target = length(offset) * max(1.0 + strength * 0.25, 1.0 + strength * 0.5);
        if (target < 0.000001) return vec2(0.5);
        float radius = length(estimate - 0.5);
        for (int i = 0; i < 4; ++i) {
            float value = strength * radius * radius;
            float derivative = 1.0 + 3.0 * value;
            if (abs(derivative) < 0.05) break;
            radius = clamp(radius - (radius * (1.0 + value) - target) / derivative, 0.0, 1.5);
        }
        return 0.5 + normalize(offset) * radius;
    }
    for (int i = 0; i < 4; ++i) {
        estimate += scene - sceneCoordinate(estimate, effect, parameters, firstDrop);
    }
    return estimate;
}

vec3 colorAt(ivec2 pixel) {
    ivec2 glPixel = ivec2(min(pixel.x, extent.x - 1), extent.y - 1 - pixel.y);
    return sourceSize == extent
            ? texelFetch(sourceTexture, glPixel, 0).rgb
            : textureLod(sourceTexture, (vec2(glPixel) + 0.5) / vec2(extent), 0.0).rgb;
}

uvec3 encodeRgb24(ivec2 pixel) {
    uvec4 rgba = uvec4(packUnorm4x8(vec4(colorAt(pixel), 0.0)),
                      packUnorm4x8(vec4(colorAt(pixel + ivec2(1, 0)), 0.0)),
                      packUnorm4x8(vec4(colorAt(pixel + ivec2(2, 0)), 0.0)),
                      packUnorm4x8(vec4(colorAt(pixel + ivec2(3, 0)), 0.0)));
    return uvec3(rgba.x | (rgba.y << 24), (rgba.y >> 8) | (rgba.z << 16), (rgba.z >> 16) | (rgba.w << 8));
}

void storeRgb24(int address, uvec3 rgb) {
    words[address] = rgb.x;
    words[address + 1] = rgb.y;
    words[address + 2] = rgb.z;
}

void packColor(ivec2 group) {
    int pixels = transport == 1 ? 4 : transport == 2 ? 2 : 1;
    ivec2 p = ivec2(group.x * pixels, group.y);
    if (any(greaterThanEqual(p, extent))) return;
    int address = offsets[mode] + p.y * rowWords;
    if (transport == 1) {
        storeRgb24(address + group.x * 3, encodeRgb24(p));
    } else if (transport == 2) {
        vec3 a = colorAt(p);
        vec3 b = colorAt(p + ivec2(1, 0));
        const vec3 luma = vec3(0.2126, 0.7152, 0.0722);
        float ya = dot(a, luma), yb = dot(b, luma);
        vec3 average = (a + b) * 0.5;
        float y = (ya + yb) * 0.5;
        words[address + group.x] = packUnorm4x8(vec4(ya, 128.0 / 255.0 + (average.b - y) / 1.8556,
                                                   yb, 128.0 / 255.0 + (average.r - y) / 1.5748));
    } else {
        words[address + p.x] = packUnorm4x8(vec4(colorAt(p), 1.0));
    }
}

uint packFinalBlock(int block, int y) {
    if (block * 4 >= extent.x || y >= extent.y) return 0u;
    int address = y * rowWords + block * 3;
    uvec3 rgb = encodeRgb24(ivec2(block * 4, y));
    bool differs = any(notEqual(rgb, uvec3(hudlessWords[address], hudlessWords[address + 1], hudlessWords[address + 2])));
    int tilesAcross = (extent.x + 127) / 128;
    int tile = (y / 8) * tilesAcross + block / 32;
    int tileAddress = tile * 768 + (y % 8) * 96 + (block % 32) * 3;
    if (differs) storeRgb24(tileAddress, rgb);
    return differs ? (1u << (block % 32)) : 0u;
}

void packFinalWithMask(int y) {
    // One bit per four pixels marks where final color differs from the HUD-less base.
    int x = int(gl_LocalInvocationID.x);
    int block = int(gl_WorkGroupID.x) * 32 + x;
    int lane = int(gl_LocalInvocationIndex);
    hudChanges[lane] = packFinalBlock(block, y) | packFinalBlock(block + 16, y);
    barrier();
    if (x == 0 && y < extent.y) {
        uint mask = 0u;
        for (int i = 0; i < 16; ++i) mask |= hudChanges[lane + i];
        int stride = (extent.x + 127) / 128;
        words[offsets[1] + y * stride + int(gl_WorkGroupID.x)] = mask;
    }
}

void main() {
    ivec2 outputPixel = ivec2(gl_GlobalInvocationID.xy);
    if (mode == FINAL_WITH_MASK) {
        packFinalWithMask(outputPixel.y);
        return;
    }
    if (mode == DEPTH_ONLY) {
        if (all(lessThan(outputPixel, extent))) {
            ivec2 glPixel = ivec2(outputPixel.x, extent.y - 1 - outputPixel.y);
            vec2 sourceExtent = vec2(sourceSize) * sourceScale;
            vec2 uv = (vec2(glPixel) + 0.5) / vec2(extent);
            ivec2 center = clamp(ivec2(uv * sourceExtent + currentJitter), ivec2(0),
                                 max(ivec2(sourceExtent) - 1, ivec2(0)));
            words[outputPixel.y * rowWords + outputPixel.x] = floatBitsToUint(texelFetch(sourceTexture, center, 0).r);
        }
        return;
    }
    bool gpuMotion = mode == APPLY_GPU_MOTION || mode == INITIALIZE_GPU_MOTION;
    bool applyMotion = mode == APPLY_MOTION || mode == INITIALIZE_MOTION || gpuMotion;
    if ((mode == DEPTH || applyMotion) && (warpTypes.x == SILDUR_RAIN || warpTypes.y == SILDUR_RAIN)) {
        if (gl_LocalInvocationIndex == 0u) {
            if (warpTypes.x == SILDUR_RAIN) buildRainDrops(0, warpParameters.x);
            if (warpTypes.y == SILDUR_RAIN) buildRainDrops(4, warpParameters.z);
        }
        barrier();
    }
    if (applyMotion) {
        if (all(lessThan(outputPixel, extent))) {
            ivec2 glPixel = ivec2(outputPixel.x, extent.y - 1 - outputPixel.y);
            vec2 uv = (vec2(glPixel) + 0.5) / vec2(extent);
            vec2 scene = sceneCoordinate(uv, warpTypes.x, warpParameters.xy, 0);
            ivec2 samplePixel = clamp(ivec2(scene * vec2(extent)), ivec2(0), extent - 1);
            vec4 sampleMotion = gpuMotion ? gpuMotionSample(samplePixel) : texelFetch(sourceTexture, samplePixel, 0);
            int address = outputPixel.y * rowWords + outputPixel.x;
            if (sampleMotion.a > 0.5) {
                vec2 velocity = sampleMotion.xy;
                if (warpTypes != ivec2(0)) {
                    vec2 currentScene = (vec2(samplePixel) + 0.5) / vec2(extent);
                    vec2 previousScene = currentScene + velocity / vec2(extent.x, -extent.y);
                    vec2 currentDisplay = displayCoordinate(currentScene, uv + currentScene - scene,
                                                            warpTypes.x, warpParameters.xy, 0);
                    vec2 previousDisplay = displayCoordinate(previousScene, currentDisplay + previousScene - currentScene,
                                                             warpTypes.y, warpParameters.zw, 4);
                    velocity = clamp((previousDisplay - currentDisplay) * vec2(extent.x, -extent.y),
                                     -vec2(extent), vec2(extent));
                }
                words[address] = floatBitsToUint(sampleMotion.z);
                words[offsets[3] + address] = packHalf2x16(velocity);
            } else if (mode == INITIALIZE_MOTION || mode == INITIALIZE_GPU_MOTION) {
                words[offsets[3] + address] = 0x7e007e00u;
            }
        }
        return;
    }
    if (mode != DEPTH) {
        packColor(outputPixel);
        return;
    }
    if (any(greaterThanEqual(outputPixel, extent))) return;

    // OpenGL textures start at the lower left. The transfer footprint starts at the upper left.
    ivec2 glPixel = ivec2(outputPixel.x, extent.y - 1 - outputPixel.y);
    vec2 uv = (vec2(glPixel) + 0.5) / vec2(extent);
    int address = outputPixel.y * rowWords + outputPixel.x;

    vec2 scene = sceneCoordinate(uv, warpTypes.x, warpParameters.xy, 0);
    vec2 sourceExtent = vec2(sourceSize) * sourceScale;
    ivec2 limit = max(ivec2(sourceExtent) - 1, ivec2(0));
    ivec2 center = clamp(ivec2(scene * sourceExtent + currentJitter), ivec2(0), limit);
    float depth = texelFetch(sourceTexture, center, 0).r;
    // Low-resolution inputs are undilated. Depth and velocity describe the same sample.
    vec2 currentNdc = ((vec2(center) + 0.5 - currentJitter) / sourceExtent) * 2.0 - 1.0;
    vec4 currentClip = vec4(currentNdc, depth * 2.0 - 1.0, 1.0);
    vec4 previous = depth >= 1.0 ? skyToPrevious * currentClip : currentToPrevious * currentClip;
    vec2 motion = vec2(0.0);
    if (previous.w > 0.00001) {
        vec2 currentScene = currentNdc * 0.5 + 0.5;
        vec2 previousScene = previous.xy / previous.w * 0.5 + 0.5;
        vec2 currentDisplay = displayCoordinate(currentScene, uv + currentScene - scene, warpTypes.x, warpParameters.xy, 0);
        vec2 previousDisplay = displayCoordinate(previousScene, currentDisplay + previousScene - currentScene,
                                                 warpTypes.y, warpParameters.zw, 4);
        motion = (previousDisplay - currentDisplay) * vec2(extent.x, -extent.y);
        motion = clamp(motion, -vec2(extent), vec2(extent));
    }
    words[offsets[DEPTH] + address] = floatBitsToUint(depth);
    words[offsets[3] + address] = packHalf2x16(motion);
}
